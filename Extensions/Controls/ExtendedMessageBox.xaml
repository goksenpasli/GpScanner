<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <local:SystemFileIconConverter x:Key="SystemFileIconConverter" />
    <Style TargetType="{x:Type local:ExtendedMessageBox}">
        <Setter Property="Background" Value="{DynamicResource BorderBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GroupBoxBackGround}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExtendedMessageBox}">
                    <Border Padding="1"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Width="96"
                                    Height="96"
                                    Margin="10"
                                    d:Content="Object"
                                    d:Visibility="Visible"
                                    Content="{TemplateBinding CustomContent}"
                                    Visibility="{TemplateBinding CustomContentVisible}" />
                                <TextBlock Margin="0,0,5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center">
                                    <Run d:Text="TITLE"
                                        FontSize="18"
                                        Text="{TemplateBinding Title}" />
                                    <LineBreak />
                                    <Run d:Text="Message"
                                        FontSize="12"
                                        Text="{TemplateBinding Message}" />
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Margin="5"
                                d:Content="Checkbox"
                                d:Visibility="Visible"
                                Content="{TemplateBinding CheckDescription}"
                                IsChecked="{TemplateBinding IsChecked}"
                                Visibility="{TemplateBinding CheckVisibility}" />
                            <ProgressBar Height="16"
                                Margin="5"
                                d:Value="40"
                                d:Visibility="Visible"
                                Visibility="{TemplateBinding ProgressBarVisibility}"
                                Value="{TemplateBinding ProgressValue}" />
                            <Expander MaxWidth="300"
                                Margin="5"
                                d:Header="HiddenCaption"
                                d:IsExpanded="True"
                                d:Visibility="Visible"
                                Header="{TemplateBinding HiddenCaption}"
                                IsExpanded="{TemplateBinding HiddenDescriptionExpanded}"
                                Visibility="{TemplateBinding HiddenDescriptionVisibility}">
                                <TextBlock d:Text="HiddenDescription"
                                    Text="{TemplateBinding HiddenDescription}"
                                    TextWrapping="Wrap" />
                            </Expander>
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="Yes"
                                    Margin="5"
                                    d:Visibility="Visible"
                                    IsEnabled="{TemplateBinding YesEnabled}"
                                    Visibility="{TemplateBinding YesButton}">
                                    <Button.Content>
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Shell32.dll" />
                                                    <Binding Source="294" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Button.Content>
                                </Button>
                                <Button x:Name="No"
                                    Grid.Column="1"
                                    Margin="5"
                                    d:Visibility="Visible"
                                    IsEnabled="{TemplateBinding NoEnabled}"
                                    Visibility="{TemplateBinding NoButton}">
                                    <Button.Content>
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Shell32.dll" />
                                                    <Binding Source="131" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>