<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Extensions">
    <local:SystemFileIconConverter x:Key="SystemFileIconConverter" />
    <Style TargetType="{x:Type local:ExtendedMessageBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExtendedMessageBox}">
                    <Border Padding="1"
                        Background="{DynamicResource BorderBackground}"
                        BorderBrush="{DynamicResource GroupBoxBackGround}"
                        BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Width="64"
                                    Height="64"
                                    Margin="5,10,10,0"
                                    Content="{TemplateBinding CustomContent}"
                                    Visibility="{TemplateBinding IsCustomContentVisible}" />
                                <TextBlock HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center">
                                    <Run FontSize="18" Text="{TemplateBinding Title}" />
                                    <LineBreak />
                                    <Run FontSize="12" Text="{TemplateBinding Message}" />
                                </TextBlock>
                            </StackPanel>
                            <UniformGrid HorizontalAlignment="Center" Columns="2">
                                <Button x:Name="Yes"
                                    Margin="5"
                                    Visibility="{TemplateBinding ShowYesButton}">
                                    <Button.Content>
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Shell32.dll" />
                                                    <Binding Source="294" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Button.Content>
                                </Button>
                                <Button x:Name="No"
                                    Margin="5"
                                    Visibility="{TemplateBinding ShowNoButton}">
                                    <Button.Content>
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Shell32.dll" />
                                                    <Binding Source="131" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Button.Content>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>