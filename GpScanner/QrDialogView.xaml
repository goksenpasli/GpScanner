<UserControl x:Class="GpScanner.QrDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converter="clr-namespace:GpScanner.Converter"
    xmlns:Extensions="clr-namespace:Extensions;assembly=Extensions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GpScanner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:GpScanner.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:GpScannerViewModel}"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Converter:StringToQrBitmapImageConverter x:Key="StringToQrBitmapImageConverter" />
    </UserControl.Resources>
    <GroupBox>
        <ListBox Width="310"
            Height="240"
            HorizontalContentAlignment="Stretch"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            Background="{StaticResource BorderBackground}"
            ItemsSource="{Binding BarcodeList}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Extensions:ButtonedTextBox Height="80"
                        IsReadOnly="True"
                        PasteButtonVisibility="Collapsed"
                        ResetButtonVisibility="Collapsed"
                        Text="{Binding Mode=OneWay}"
                        TextWrapping="Wrap">
                        <Extensions:ButtonedTextBox.Description>
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="Img"
                                    Width="80"
                                    Height="80"
                                    d:Source="{Binding Source='GPSCANNER', Converter={StaticResource StringToQrBitmapImageConverter}, Mode=OneWay}"
                                    Source="{Binding Converter={StaticResource StringToQrBitmapImageConverter}, Mode=OneWay}" />
                                <UniformGrid Rows="2">
                                    <Button Command="{Binding DataContext.SaveQrImage, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding ElementName=Img, Path=Source, Mode=OneWay}">
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Shell32.dll" />
                                                    <Binding Source="6" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Button>
                                    <Button Command="{Binding DataContext.PrintImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding ElementName=Img, Path=Source, Mode=OneWay}">
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Shell32.dll" />
                                                    <Binding Source="16" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Extensions:ButtonedTextBox.Description>
                    </Extensions:ButtonedTextBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </GroupBox>
</UserControl>
