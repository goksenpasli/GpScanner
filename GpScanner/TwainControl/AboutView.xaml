<UserControl x:Class="TwainControl.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Extensions.Controls;assembly=Extensions"
    xmlns:Extensions="clr-namespace:Extensions;assembly=Extensions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TwainControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:TwainControl.Properties"
    d:DataContext="{d:DesignInstance Type=local:TwainCtrl}"
    d:DesignHeight="400"
    d:DesignWidth="500"
    local:Translation.ResourceManager="{x:Static properties:Resources.ResourceManager}"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Extensions;component/Controls/Skin.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Extensions:BindingProxy x:Key="Proxy" Data="{Binding ElementName=TbLic}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox Background="{StaticResource GroupBoxBackGround}">
        <GroupBox.Header>
            <UniformGrid Columns="2">
                <TextBlock Text="{local:Loc ABOUT}" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding Version.FileVersion}" />
            </UniformGrid>
        </GroupBox.Header>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="20" TextWrapping="Wrap">
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/goksenpasli?tab=repositories">
                        <Run Text="{local:Loc OTHERAPPS}" />
                    </Hyperlink>
                </TextBlock>
                <Separator />
                <TextBlock FontWeight="Bold"
                    Text="{local:Loc APPDESC}"
                    TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,0"
                    Background="Red"
                    Text="{local:Loc THIRDPARTY}"
                    TextWrapping="Wrap" />
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/charlesw/tesseract">
                        TESSERACT
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="http://www.pdfsharp.net">
                        PDFSHARP
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/micjahn/ZXing.Net">
                        ZXing.Net
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/GMZ">
                        TWAINWPF
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/JosePineiro/MozJpeg-wrapper">
                        MozJpeg
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://bitbucket.org/jvandezande/wpfcap/src/master/">
                        WPFCap
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/pvginkel/PdfiumViewer">
                        PdfiumViewer
                    </Hyperlink>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://www.nuget.org/packages/bblanchon.PDFium.Win32">
                        NuGet
                    </Hyperlink>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit" Command="{Binding ExtractNugetPackage}">
                        Install
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/JosePineiro/WebP-wrapper">
                        WebP-Wrapper
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/xceedsoftware/docx">
                        DocX
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/ExcelDataReader/ExcelDataReader">
                        ExcelDataReader
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://www.nuget.org/packages/EntityFramework/6.4.4">
                        EntityFramework
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://www.nuget.org/packages/System.Data.SQLite/1.0.118">
                        SQLite
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/adoconnection/SevenZipExtractor">
                        SevenZipExtractor
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/adamhathcock/sharpcompress">
                        SharpCompress
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://github.com/gstolarov/JBIG2-JPX?tab=readme-ov-file">
                        JBIG2/JPX Decoder
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink local:Policy.PolicyName="WebAdreseGit"
                        Command="{Binding WebAdreseGit}"
                        CommandParameter="https://soft.rubypdf.com/software/lossless-jbig2-encoder-windows-dynamic-libary">
                        JBIG2 Encoder
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <Grid Grid.Column="1">
                <Grid.DataContext>
                    <local:AboutViewTranslateViewModel />
                </Grid.DataContext>
                <Extensions:ButtonedTextBox x:Name="TbLic"
                    Margin="0,8,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    OpenButtonVisibility="Collapsed"
                    PasteButtonVisibility="Collapsed"
                    PrintButtonVisibility="Visible"
                    ResetButtonVisibility="Collapsed"
                    Text="{local:Loc LICENSE}"
                    VerticalScrollBarVisibility="Auto" />
                <Extensions:ContentToggleButton HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Extensions:ContentToggleButton.OverContent>
                        <GroupBox Width="{Binding Path=Data.ActualWidth, Source={StaticResource Proxy}}" Height="{Binding Path=Data.ActualHeight, Source={StaticResource Proxy}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Controls:TranslateView SourceLangIsEnabled="False" />
                                <Extensions:ButtonedTextBox Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    IsReadOnly="True"
                                    OpenButtonVisibility="Collapsed"
                                    PasteButtonVisibility="Collapsed"
                                    PrintButtonVisibility="Visible"
                                    ResetButtonVisibility="Collapsed"
                                    Text="{Binding Çeviri, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </GroupBox>
                    </Extensions:ContentToggleButton.OverContent>
                </Extensions:ContentToggleButton>
            </Grid>
        </Grid>
    </GroupBox>
</UserControl>