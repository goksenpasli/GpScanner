<UserControl x:Class="TwainControl.PdfImportViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converter="clr-namespace:TwainControl.Converter"
    xmlns:Extensions="clr-namespace:Extensions;assembly=Extensions"
    xmlns:Pdfviewer="clr-namespace:PdfViewer;assembly=PdfViewer"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:controls="clr-namespace:Extensions.Controls;assembly=Extensions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ice="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:local="clr-namespace:TwainControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pdfium="clr-namespace:PdfiumViewer;assembly=PdfiumViewer"
    xmlns:properties="clr-namespace:TwainControl.Properties"
    d:DataContext="{d:DesignInstance Type=local:TwainCtrl}"
    d:DesignHeight="600"
    d:DesignWidth="420"
    local:Translation.ResourceManager="{x:Static properties:Resources.ResourceManager}"
    FocusManager.FocusedElement="{Binding Source={x:Reference grid}}"
    Loaded="UserControl_Loaded"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TwainControl;component/CommonResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Converter:XKnownColorToBrushConverter x:Key="XKnownColorToBrushConverter" />
            <Converter:Base64StringToStrokeCollectionConverter x:Key="Base64StringToStrokeCollectionConverter" />
            <Extensions:NullableToBooleanConverter x:Key="NullableToBooleanConverter" />
            <Extensions:SystemFileIconConverter x:Key="SystemFileIconConverter" />
            <Extensions:FilePathToIconConverter x:Key="FilePathToIconConverter" />
            <Extensions:FilePathToFileNameConverter x:Key="FilePathToFileNameConverter" />
            <Extensions:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <Pdfviewer:PdfPageToThumbImageConverter x:Key="PdfPageToThumbImageConverter" />
            <Pdfviewer:PageNumberOneUpConverter x:Key="PageNumberOneUpConverter" />
            <Style TargetType="ComboBox">
                <Setter Property="Template" Value="{StaticResource ComboBoxStyle}" />
            </Style>
            <Style BasedOn="{StaticResource NumericUpDownStyle}" TargetType="Extensions:NumericUpDown" />
            <Image x:Key="PdfImage"
                Width="16"
                Height="16"
                x:Shared="false"
                Source="{Binding Converter={StaticResource FilePathToIconConverter}, Source=.pdf}" />
            <LinearGradientBrush x:Key="BorderBackground" ice:Freeze="True" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop ice:Freeze="True" Offset="0" Color="#FFFDFEFF" />
                <GradientStop ice:Freeze="True" Offset="1" Color="#FFC1D3EA" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="grid" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <WrapPanel Orientation="Horizontal">
            <Menu Background="{x:Null}" IsMainMenu="False">
                <MenuItem>
                    <MenuItem Name="Clear"
                        Command="{Binding ClearPdfHistory, Mode=OneWay}"
                        Header="{local:Loc CLEARLIST}">
                        <MenuItem.Icon>
                            <Image Width="16"
                                Height="16"
                                Source="/TwainControl;component/Icons/delete.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding ClosePdfFile, Mode=OneWay}"
                        CommandParameter="{Binding Source={x:Reference PdfViewer}}"
                        Header="{local:Loc CLOSEFILE}">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="Shell32.dll" />
                                        <Binding Source="27" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem IsEnabled="{Binding ElementName=Clear, Path=IsEnabled}" ItemsSource="{Binding PdfLoadHistory, Mode=OneWay, Source={x:Static properties:Settings.Default}}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{local:Loc DOCUMENT}" />
                                <Extensions:NumericUpDown IsReadOnly="True"
                                    Maximum="100"
                                    Minimum="1"
                                    Value="{Binding PdfLoadHistoryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
                                <TextBlock VerticalAlignment="Center" Text="{local:Loc FILE}" />
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem.Icon>
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="Shell32.dll" />
                                        <Binding Source="1" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </MenuItem.Icon>
                        <MenuItem.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2" Orientation="Horizontal">
                                    <Pdfviewer:PdfShadowedImage x:Name="PdfImg"
                                        Width="128"
                                        Height="128"
                                        Source="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag.Result, IsAsync=True}">
                                        <Image.Tag>
                                            <MultiBinding Converter="{StaticResource PdfPageToThumbImageConverter}">
                                                <Binding Mode="OneWay" />
                                                <Binding Mode="OneWay">
                                                    <Binding.Source>
                                                        <System:Int32>1</System:Int32>
                                                    </Binding.Source>
                                                </Binding>
                                                <Binding ElementName="PdfViewer"
                                                    Mode="OneWay"
                                                    Path="PdfFilePath" />
                                            </MultiBinding>
                                        </Image.Tag>
                                    </Pdfviewer:PdfShadowedImage>
                                    <Extensions:FileBreadCrumbControl VerticalAlignment="Center"
                                        Background="{x:Null}"
                                        FilePath="{Binding Mode=OneWay}"
                                        InternalBackground="{StaticResource BorderBackground}"
                                        IsEnabled="{Binding ElementName=PdfImg, Path=Source, Mode=OneWay, Converter={StaticResource NullableToBooleanConverter}}"
                                        Orientation="Vertical"
                                        ShowFileName="Visible" />
                                    <TextBlock>
                                        <Hyperlink Command="{Binding DataContext.PdfViewerFullScreen, RelativeSource={RelativeSource AncestorType=local:PdfImportViewerControl}}"
                                            CommandParameter="{Binding Mode=OneWay}"
                                            IsEnabled="{Binding ElementName=PdfImg, Path=Source, Mode=OneWay, Converter={StaticResource NullableToBooleanConverter}}"
                                            TextDecorations="None">
                                            <Run FontFamily="Wingdings 2"
                                                FontSize="17"
                                                FontWeight="Bold"
                                                Text="4" />
                                        </Hyperlink>
                                        <Hyperlink Command="{Binding RemovePdfHistoryFile, RelativeSource={RelativeSource AncestorType=local:PdfImportViewerControl}}"
                                            CommandParameter="{Binding Mode=OneWay}"
                                            TextDecorations="None">
                                            <InlineUIContainer BaselineAlignment="Center">
                                                <Image Width="16"
                                                    Height="16"
                                                    Source="/TwainControl;component/Icons/delete.png" />
                                            </InlineUIContainer>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </MenuItem.ItemTemplate>
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Command" Value="{Binding OpenPdfHistoryFile, RelativeSource={RelativeSource AncestorType=local:PdfImportViewerControl}}" />
                                <Setter Property="CommandParameter" Value="{Binding Mode=OneWay}" />
                                <Setter Property="Icon" Value="{StaticResource PdfImage}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem.Header>
                        <Image Width="20" Height="20">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                    <Binding Source="Shell32.dll" />
                                    <Binding Source="239" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <Button local:Policy.PolicyName="AddAllFileToControlPanel"
                BorderBrush="Cyan"
                Command="{Binding AddAllFileToControlPanel}"
                CommandParameter="{Binding ElementName=PdfViewer, Mode=OneWay}">
                <Button.Content>
                    <TextBlock FontFamily="Wingdings"
                        FontSize="16"
                        Text="ç" />
                </Button.Content>
            </Button>
            <Extensions:ContentToggleButton>
                <Extensions:ContentToggleButton.OverContent>
                    <Border Background="{DynamicResource BorderBackground}"
                        BorderBrush="{DynamicResource GroupBoxBackGround}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Extensions:NumericUpDown Interval="1"
                                IsEnabled="{Binding PdfFilePath, Converter={StaticResource NullableToBooleanConverter}, Source={x:Reference PdfViewer}}"
                                Maximum="{Binding Source={x:Reference PdfViewer}, Path=ToplamSayfa}"
                                Minimum="1"
                                Value="{Binding SayfaBaşlangıç, UpdateSourceTrigger=PropertyChanged}" />
                            <Extensions:NumericUpDown Interval="1"
                                IsEnabled="{Binding PdfFilePath, Converter={StaticResource NullableToBooleanConverter}, Source={x:Reference PdfViewer}}"
                                Maximum="{Binding Source={x:Reference PdfViewer}, Path=ToplamSayfa}"
                                Minimum="1"
                                Value="{Binding SayfaBitiş, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Extensions:ContentToggleButton.OverContent>
            </Extensions:ContentToggleButton>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <Extensions:ContentToggleButton StaysOpen="True" TopMost="False">
                <Grid>
                    <Image Width="16" Height="16">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                <Binding Source="Shell32.dll" />
                                <Binding Source="70" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <Image Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Source="{Binding Converter={StaticResource FilePathToIconConverter}, Source=.pdf}" />
                </Grid>
                <Extensions:ContentToggleButton.OverContent>
                    <Extensions:ResizablePanel Width="720"
                        Height="480"
                        MinWidth="360"
                        MinHeight="200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding Scanner.MergePdfFiles}"
                                VirtualizingPanel.CacheLengthUnit="Pixel"
                                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Standard">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <ContentPresenter d:ContentTemplateSelector="{StaticResource PdfEypViewerSelector}"
                                                        d:Height="315"
                                                        d:Width="315"
                                                        Content="{Binding Mode=OneWay}"
                                                        ContentTemplateSelector="{StaticResource PdfEypViewerSelector}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Extensions:VirtualizingWrapPanel CanHorizontallyScroll="False"
                                            ItemSize="230,330"
                                            SpacingMode="None" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Hyperlink Command="{Binding DataContext.MergePdfListRemoveFile, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Mode=OneWay}">
                                                <Run Text="{Binding Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <CheckBox Grid.Row="1"
                                Content="{local:Loc ADDFIRST}"
                                IsChecked="{Binding MergePdfFileToFirst}" />
                            <UniformGrid Grid.Row="2" Columns="3">
                                <Button Command="{Binding MergePdfListAddFile}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="32"
                                            Height="32"
                                            Source="{Binding Converter={StaticResource FilePathToIconConverter}, Source=.pdf}" />
                                        <TextBlock VerticalAlignment="Center" Text="{local:Loc FILE}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding MergePdfListToCurrentFile}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Imageres.dll" />
                                                    <Binding Source="166" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{local:Loc FILE}" />
                                            <Run Text="{local:Loc MERGEPDF}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding MergePdfListToFile}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Shell32.dll" />
                                                    <Binding Source="6" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock VerticalAlignment="Center" Text="{local:Loc SAVEPDF}" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Extensions:ResizablePanel>
                </Extensions:ContentToggleButton.OverContent>
            </Extensions:ContentToggleButton>
            <Extensions:ContentToggleButton ArrowVisibility="Collapsed"
                Command="{Binding LoadPdfExtractFile}"
                CommandParameter="{Binding ElementName=PdfViewer, Mode=OneWay}"
                StaysOpen="True"
                TopMost="False">
                <Canvas Width="16" Height="16">
                    <Image Canvas.Left="2"
                        Canvas.Top="-2"
                        Width="16"
                        Height="16">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                <Binding Source="Shell32.dll" />
                                <Binding Source="54" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <Image Canvas.Left="-2"
                        Canvas.Top="2"
                        Width="16"
                        Height="16">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                <Binding Source="Shell32.dll" />
                                <Binding Source="54" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </Canvas>
                <Extensions:ContentToggleButton.OverContent>
                    <Extensions:ResizablePanel Width="500"
                        Height="300"
                        MinWidth="500"
                        MinHeight="300">
                        <Grid IsEnabled="{Binding PdfFilePath, Converter={StaticResource NullableToBooleanConverter}, Source={x:Reference PdfViewer}}">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding PdfPages}"
                                SelectionMode="Extended"
                                Tag="{Binding Source={x:Reference PdfViewer}}"
                                VirtualizingPanel.CacheLengthUnit="Pixel"
                                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Standard">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding Selected}">
                                            <CheckBox.Content>
                                                <StackPanel>
                                                    <Extensions:NumericUpDown Maximum="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        Minimum="1"
                                                        Value="{Binding PageNumber}" />
                                                    <TextBlock HorizontalAlignment="Center">
                                                        <Run d:Text="PAGENUMBER" Text="{local:Loc PAGENUMBER}" />
                                                        <Run Text="{Binding PageNumber, Mode=OneTime}" />
                                                        <LineBreak />
                                                        <Hyperlink local:Policy.PolicyName="CopyPdfBitmapFile"
                                                            Command="{Binding Tag.CopyPdfBitmapFile, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding PageNumber, Mode=OneWay}"
                                                            TextDecorations="None">
                                                            <InlineUIContainer BaselineAlignment="Center">
                                                                <Image Width="16" Height="16">
                                                                    <Image.Source>
                                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                                            <Binding Source="Shell32.dll" />
                                                                            <Binding Source="134" />
                                                                        </MultiBinding>
                                                                    </Image.Source>
                                                                </Image>
                                                            </InlineUIContainer>
                                                        </Hyperlink><Hyperlink local:Policy.PolicyName="FlipPdfPage"
                                                            BaselineAlignment="Center"
                                                            Command="{Binding Tag.FlipPdfPage, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding PageNumber, Mode=OneWay}"
                                                            TextDecorations="None">
                                                            <InlineUIContainer BaselineAlignment="Center">
                                                                <Image Width="16" Height="16">
                                                                    <Image.Source>
                                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                                            <Binding Source="Shell32.dll" />
                                                                            <Binding Source="252" />
                                                                        </MultiBinding>
                                                                    </Image.Source>
                                                                </Image>
                                                            </InlineUIContainer>
                                                        </Hyperlink><Hyperlink local:Policy.PolicyName="RotateSelectedPage"
                                                            BaselineAlignment="Center"
                                                            Command="{Binding Tag.RotateSelectedPage, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding PageNumber, Mode=OneWay}"
                                                            TextDecorations="None">
                                                            <InlineUIContainer BaselineAlignment="Center">
                                                                <Image Width="16"
                                                                    Height="16"
                                                                    Source="/TwainControl;component/Icons/rotate.png" />
                                                            </InlineUIContainer>
                                                        </Hyperlink><Hyperlink local:Policy.PolicyName="InvertSelectedPage"
                                                            BaselineAlignment="Center"
                                                            Command="{Binding Tag.InvertSelectedPage, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding PageNumber, Mode=OneWay}"
                                                            TextDecorations="None">
                                                            <Run FontFamily="Wingdings"
                                                                FontSize="18"
                                                                Text="[" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <Pdfviewer:ShadowedImage Width="96"
                                                        Height="96"
                                                        HorizontalAlignment="Center"
                                                        ShowShadow="True"
                                                        Source="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag.Result, IsAsync=True}">
                                                        <Pdfviewer:ShadowedImage.Tag>
                                                            <MultiBinding Converter="{StaticResource PdfPageToThumbImageConverter}">
                                                                <Binding ElementName="PdfViewer" Path="PdfFilePath" />
                                                                <Binding Mode="OneWay" Path="PageNumber" />
                                                            </MultiBinding>
                                                        </Pdfviewer:ShadowedImage.Tag>
                                                    </Pdfviewer:ShadowedImage>
                                                </StackPanel>
                                            </CheckBox.Content>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Extensions:VirtualizingWrapPanel CanHorizontallyScroll="False"
                                            ItemSize="140,170"
                                            StretchItems="False" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <UniformGrid Grid.Row="1"
                                Columns="3"
                                Rows="2">
                                <Extensions:ContentToggleButton>
                                    <Image Width="24"
                                        Height="24"
                                        Source="/TwainControl;component/Icons/selectall.png" />
                                    <Extensions:ContentToggleButton.OverContent>
                                        <UniformGrid Width="{Binding Path=ActualWidth, Source={x:Reference BtnMarkReverse}}" Rows="3">
                                            <Button Command="{Binding PdfImportViewerTümünüİşaretle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="24"
                                                        Height="24"
                                                        Source="/TwainControl;component/Icons/selectall.png" />
                                                    <TextBlock VerticalAlignment="Center" Text="{local:Loc ALL}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding PdfImportViewerTekİşaretle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="24"
                                                        Height="24"
                                                        Source="/TwainControl;component/Icons/selectall.png" />
                                                    <TextBlock VerticalAlignment="Center" Text="1-3-5-7-9-11..." />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding PdfImportViewerÇiftİşaretle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="24"
                                                        Height="24"
                                                        Source="/TwainControl;component/Icons/selectall.png" />
                                                    <TextBlock VerticalAlignment="Center" Text="2-4-6-8-10-12..." />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </Extensions:ContentToggleButton.OverContent>
                                </Extensions:ContentToggleButton>
                                <Button x:Name="BtnMarkReverse" Command="{Binding PdfImportViewerTersiniİşaretle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="24"
                                            Height="24"
                                            Source="/TwainControl;component/Icons/inverse.png" />
                                        <TextBlock VerticalAlignment="Center" Text="{local:Loc REVERSE}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShufflePdfPages}">
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas Width="16"
                                            Height="16"
                                            Background="Transparent">
                                            <Canvas.Resources>
                                                <Style BasedOn="{StaticResource RandomDiceStyle}" TargetType="Ellipse" />
                                            </Canvas.Resources>
                                            <Ellipse Canvas.Left="6" Canvas.Top="6" />
                                            <Ellipse Canvas.Left="1.5" Canvas.Top="2" />
                                            <Ellipse Canvas.Left="10.5" Canvas.Top="10.5" />
                                            <Ellipse Canvas.Left="10.5" Canvas.Top="2" />
                                            <Ellipse Canvas.Left="1.5" Canvas.Top="10.5" />
                                        </Canvas>
                                        <TextBlock VerticalAlignment="Center" Text="{local:Loc RANDOM}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExtractMultiplePdfFile}" CommandParameter="{Binding Source={x:Reference PdfViewer}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="24"
                                            Height="24"
                                            VerticalAlignment="Bottom"
                                            Source="/TwainControl;component/Icons/save.png" />
                                        <TextBlock Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{local:Loc SAVESELECTED}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Command="{Binding LoadArrangedPdfFile}"
                                    CommandParameter="{Binding Source={x:Reference PdfViewer}}">
                                    <Grid>
                                        <ProgressBar Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Maximum="1"
                                            Value="{Binding Scanner.PdfSaveProgressValue}" />
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Image Width="24"
                                                Height="24"
                                                VerticalAlignment="Bottom"
                                                Source="/TwainControl;component/Icons/save.png" />
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{local:Loc SORT}" />
                                                <LineBreak />
                                                <Run Text="{local:Loc SAVEPDF}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    local:Policy.PolicyName="RemoveArrangedPdfFile"
                                    Command="{Binding RemoveArrangedPdfFile}"
                                    CommandParameter="{Binding Source={x:Reference PdfViewer}}">
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Image Width="24"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            Source="/TwainControl;component/Icons/delete.png" />
                                        <TextBlock VerticalAlignment="Center" Text="{local:Loc DELETE}" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Extensions:ResizablePanel>
                </Extensions:ContentToggleButton.OverContent>
            </Extensions:ContentToggleButton>
            <Button local:Policy.PolicyName="ReversePdfFile"
                Command="{Binding ReversePdfFile}"
                CommandParameter="{Binding ElementName=PdfViewer}">
                <Image Width="16" Height="16">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                            <Binding Source="Shell32.dll" />
                            <Binding Source="238" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
            </Button>
            <Button local:Policy.PolicyName="AddPdfAttachmentFile"
                Command="{Binding AddPdfAttachmentFile}"
                CommandParameter="{Binding ElementName=PdfViewer}">
                <Image Width="16" Height="16">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                            <Binding Source="Shell32.dll" />
                            <Binding Source="84" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
            </Button>
            <Button BorderBrush="Cyan"
                Command="{Binding CopyPdfBitmapFile}"
                CommandParameter="{Binding ElementName=PdfViewer, Mode=OneWay}">
                <Image Width="16" Height="16">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                            <Binding Source="Shell32.dll" />
                            <Binding Source="134" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
            </Button>
            <Button local:Policy.PolicyName="PasteFileToPdfFile"
                BorderBrush="Cyan"
                Command="{Binding PasteFileToPdfFile}"
                CommandParameter="{Binding ElementName=PdfViewer, Mode=OneWay}">
                <Button.Content>
                    <Image Width="16" Height="16">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                <Binding Source="Shell32.dll" />
                                <Binding Source="260" />
                            </MultiBinding>
                        </Image.Source>
