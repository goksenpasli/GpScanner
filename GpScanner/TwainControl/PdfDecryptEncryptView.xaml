<UserControl x:Class="TwainControl.PdfDecryptEncryptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Extensions="clr-namespace:Extensions;assembly=Extensions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TwainControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:TwainControl.Properties"
    d:DataContext="{d:DesignInstance Type=local:PdfSecurityViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    local:Translation.ResourceManager="{x:Static properties:Resources.ResourceManager}"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <Extensions:FilePathToFileNameConverter x:Key="FilePathToFileNameConverter" />
            <Extensions:FilePathToIconConverter x:Key="FilePathToIconConverter" />
            <Extensions:SystemFileIconConverter x:Key="SystemFileIconConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Button Command="{Binding BrowseCommand}">
            <StackPanel Orientation="Horizontal">
                <Image Width="16"
                    Height="16"
                    Source="{Binding Converter={StaticResource FilePathToIconConverter}, Source=.pdf}" />
                <TextBlock Text="{local:Loc SRC}" />
            </StackPanel>
        </Button>
        <UniformGrid Grid.Row="1"
            Columns="3"
            Rows="2">
            <Button Command="{Binding CheckAllCommand}">
                <Image Width="24"
                    Height="24"
                    Source="/TwainControl;component/Icons/selectall.png" />
            </Button>
            <Button Command="{Binding CheckNoneCommand}">
                <Image Width="24"
                    Height="24"
                    Source="/TwainControl;component/Icons/none.png" />
            </Button>
            <Button Command="{Binding CheckReverseCommand}">
                <Image Width="24"
                    Height="24"
                    Source="/TwainControl;component/Icons/inverse.png" />
            </Button>
            <Extensions:ButtonedTextBox VerticalContentAlignment="Center"
                CopyButtonVisibility="Collapsed"
                OpenButtonVisibility="Collapsed"
                PasteButtonVisibility="Collapsed"
                ResetButtonVisibility="Collapsed"
                Text="{Binding UserCommonPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Watermark="{local:Loc PASSWORD}" />
            <Button Command="{Binding DecryptAllCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="24" Height="24">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                <Binding Source="Shell32.dll" />
                                <Binding Source="104" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <TextBlock VerticalAlignment="Center" Text="{local:Loc ALL}" />
                </StackPanel>
            </Button>
            <Extensions:SplitButton Command="{Binding EncryptAllCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="24" Height="24">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                <Binding Source="Shell32.dll" />
                                <Binding Source="47" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <TextBlock VerticalAlignment="Center" Text="{local:Loc ALL}" />
                </StackPanel>
                <Extensions:SplitButton.InternalContent>
                    <Border Background="{StaticResource BorderBackground}"
                        BorderBrush="{StaticResource GroupBoxBackGround}"
                        BorderThickness="1">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="MenuItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style TargetType="Image">
                                    <Setter Property="Height" Value="16" />
                                    <Setter Property="Width" Value="16" />
                                </Style>
                            </StackPanel.Resources>
                            <MenuItem Header="Permit Accessibility Extract Content"
                                IsCheckable="True"
                                IsChecked="{Binding PermitAccessibilityExtractContent}" />
                            <MenuItem Header="Permit Annotations"
                                IsCheckable="True"
                                IsChecked="{Binding PermitAnnotations}" />
                            <MenuItem Header="Permit Assemble Document"
                                IsCheckable="True"
                                IsChecked="{Binding PermitAssembleDocument}" />
                            <MenuItem Header="Permit Extract Content"
                                IsCheckable="True"
                                IsChecked="{Binding PermitExtractContent}" />
                            <MenuItem Header="Permit Forms Fill"
                                IsCheckable="True"
                                IsChecked="{Binding PermitFormsFill}" />
                            <MenuItem Header="Permit Full Quality Print"
                                IsCheckable="True"
                                IsChecked="{Binding PermitFullQualityPrint}" />
                            <MenuItem Header="Permit Modify Document"
                                IsCheckable="True"
                                IsChecked="{Binding PermitModifyDocument}" />
                            <MenuItem Header="Permit Print"
                                IsCheckable="True"
                                IsChecked="{Binding PermitPrint}" />
                        </StackPanel>
                    </Border>
                </Extensions:SplitButton.InternalContent>
            </Extensions:SplitButton>
        </UniformGrid>
        <ItemsControl Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            ItemsSource="{Binding Files}"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.IsVirtualizing="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Bd"
                        Margin="2"
                        BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="BorderBrush" Value="Green" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="{x:Null}">
                                        <Setter Property="BorderBrush" Value="Black" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding IsChecked}">
                            <StackPanel Margin="1" Orientation="Horizontal">
                                <Image Width="32"
                                    Height="32"
                                    Source="{Binding Converter={StaticResource FilePathToIconConverter}, Source=.pdf}">
                                    <Image.ToolTip>
                                        <ToolTip>
                                            <ContentControl Content="{Binding InputPath}" ContentTemplate="{StaticResource SimplePdfTemplate}" />
                                        </ToolTip>
                                    </Image.ToolTip>
                                </Image>
                                <TextBlock Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding InputPath, Converter={StaticResource FilePathToFileNameConverter}}" />
                                <StackPanel>
                                    <Extensions:ButtonedTextBox CopyButtonVisibility="Collapsed"
                                        OpenButtonVisibility="Collapsed"
                                        PasteButtonVisibility="Collapsed"
                                        ResetButtonVisibility="Collapsed"
                                        Text="{Binding UserPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Watermark="{local:Loc PASSWORD}" />
                                    <UniformGrid Columns="2">
                                        <Button Width="48" Command="{Binding DecryptCommand}">
                                            <Image Width="32" Height="32">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Shell32.dll" />
                                                        <Binding Source="104" />
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </Button>
                                        <Button Width="48" Command="{Binding EncryptCommand}">
                                            <Image Width="32" Height="32">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Shell32.dll" />
                                                        <Binding Source="47" />
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                                <TextBlock Width="120"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{Binding ElementName=Bd, Path=BorderBrush}"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.Template>
                <ControlTemplate>
                    <Border Padding="{TemplateBinding Control.Padding}"
                        Background="{TemplateBinding Panel.Background}"
                        BorderBrush="{TemplateBinding Border.BorderBrush}"
                        BorderThickness="{TemplateBinding Border.BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Control.Padding}" Focusable="False">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>
        </ItemsControl>
    </Grid>
</UserControl>
