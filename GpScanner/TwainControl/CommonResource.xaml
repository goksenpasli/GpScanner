<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Extensions.Controls;assembly=Extensions"
    xmlns:Converter="clr-namespace:TwainControl.Converter"
    xmlns:Extensions="clr-namespace:Extensions;assembly=Extensions"
    xmlns:PdfViewer="clr-namespace:PdfViewer;assembly=PdfViewer"
    xmlns:Printing="clr-namespace:System.Drawing.Printing;assembly=System.Drawing"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:ice="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:local="clr-namespace:TwainControl"
    xmlns:pdfsharpdrawing="clr-namespace:PdfSharp.Drawing;assembly=PdfSharp-wpf"
    xmlns:properties="clr-namespace:TwainControl.Properties;assembly=TwainControl"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Extensions;component/Controls/Skin.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Converter:ResourceLanguageStringConverter x:Key="ResourceLanguageStringConverter" />
    <Converter:PdfPageCountConverter x:Key="PdfPageCountConverter" />
    <Extensions:SystemFileIconConverter x:Key="SystemFileIconConverter" />
    <Extensions:ReverseBooleanConverter x:Key="ReverseBooleanConverter" />
    <Extensions:FilePathToIconConverter x:Key="FilePathToIconConverter" />
    <Extensions:FilePathToFileNameConverter x:Key="FilePathToFileNameConverter" />
    <Extensions:FilePathToIconConverter x:Key="FilePathToIconLargeConverter" IconSize="jumbo" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Converter:WebpFileToBitmapImageConverter x:Key="WebpFileToBitmapImageConverter" />
    <Converter:Jb2ToBitmapImageConverter x:Key="Jb2ToBitmapImageConverter" />
    <LinearGradientBrush x:Key="BorderBackground" ice:Freeze="True" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop ice:Freeze="True" Offset="0" Color="{Binding Path=BorderBackground1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
        <GradientStop ice:Freeze="True" Offset="1" Color="{Binding Path=BorderBackground2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GroupBoxBackGround" ice:Freeze="True" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop ice:Freeze="True" Offset="0" Color="{Binding Path=GroupBoxBackGround1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
        <GradientStop ice:Freeze="True" Offset="1" Color="{Binding Path=GroupBoxBackGround2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollBarDisabledBackground"
        ice:Freeze="True"
        Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="ScrollBarSolidBackground"
        ice:Freeze="True"
        Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="ThumbBarSolidBackground"
        ice:Freeze="True"
        Color="#FF4DB2F7" />
    <SolidColorBrush x:Key="ThumbBarSolidBackground_MouseMove"
        ice:Freeze="True"
        Color="#FF0B97F5" />
    <SolidColorBrush x:Key="ThumbBarSolidBackground_Draging"
        ice:Freeze="True"
        Color="#FF007ACC" />
    <Style x:Key="RandomDiceStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Orange" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Width" Value="4" />
    </Style>
    <Style x:Key="TextBlockPdfLayout" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="Left">
                <Setter Property="Text" Value="j" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Middle">
                <Setter Property="Text" Value="h" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Right">
                <Setter Property="Text" Value="k" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="LeftBottom">
                <Setter Property="Text" Value="l" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="MiddleBottom">
                <Setter Property="Text" Value="i" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="RightBottom">
                <Setter Property="Text" Value="m" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="VerticalLines">
        <Canvas Width="16" Height="16">
            <Path Data="M3,1 H11 L15,5 V15 H3 Z"
                Fill="White"
                SnapsToDevicePixels="True"
                Stroke="Black"
                StrokeLineJoin="Round"
                StrokeThickness="1" />
            <Path Data="M11,1 L11,5 L15,5"
                Fill="Transparent"
                SnapsToDevicePixels="True"
                Stroke="Black"
                StrokeLineJoin="Round"
                StrokeThickness="1" />
            <Path Data="M5,6 V13"
                Opacity="0.5"
                Stroke="Black"
                StrokeThickness="1" />
            <Path Data="M7,6 V13"
                Stroke="Black"
                StrokeThickness="1" />
            <Path Data="M9,6 V13"
                Opacity="0.3"
                Stroke="Black"
                StrokeThickness="1" />
            <Path Data="M11,6 V13"
                Opacity="0.85"
                Stroke="Black"
                StrokeThickness="1" />
            <Path Data="M13,6 V13"
                Stroke="Black"
                StrokeThickness="1" />
        </Canvas>
    </DataTemplate>
    <ControlTemplate x:Key="SimpleArchiveViewerTemplate" TargetType="{x:Type local:SimpleArchiveViewer}">
        <ListBox Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Foreground="{TemplateBinding Foreground}"
            IsSynchronizedWithCurrentItem="False"
            ItemsSource="{Binding Arşivİçerik, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}"
            SelectedItem="{Binding SelectedFile, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}"
            SelectionMode="Single"
            VirtualizingPanel.CacheLengthUnit="Pixel"
            VirtualizingPanel.IsVirtualizingWhenGrouping="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <InlineUIContainer BaselineAlignment="Center">
                            <Image Width="16"
                                Height="16"
                                Source="{Binding DosyaAdı, IsAsync=True, Converter={StaticResource FilePathToIconConverter}}" />
                        </InlineUIContainer>
                        <Run Text="{Binding DosyaAdı, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding ArşivTekDosyaÇıkar, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}" MouseAction="LeftDoubleClick" />
                                    </Border.InputBindings>
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D9EBF9" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="False">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#CCE8FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </ControlTemplate>
    <ControlTemplate x:Key="DefaultArchiveViewerTemplate" TargetType="{x:Type local:SimpleArchiveViewer}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="2*" MaxWidth="{Binding PreviewPanelWidth, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="Lv"
                Extensions:GridViewSort.AutoSort="True"
                AlternationCount="2"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Foreground="{TemplateBinding Foreground}"
                IsSynchronizedWithCurrentItem="False"
                ItemsSource="{Binding Arşivİçerik, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}"
                ScrollViewer.IsDeferredScrollingEnabled="False"
                SelectedItem="{Binding SelectedFile, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}"
                SelectionMode="Single"
                VirtualizingPanel.CacheLengthUnit="Pixel"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Mode=Self}}">
                                    <MenuItem Command="{Binding Tag.SeçiliAyıkla}" Header="SEÇİLİLERİ AYIKLA" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Tag" Value="{Binding Mode=OneWay, RelativeSource={RelativeSource AncestorType=Extensions:ArchiveViewer}}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding ArşivTekDosyaÇıkar, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}" MouseAction="LeftDoubleClick" />
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <GridViewRowPresenter Margin="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Content="{TemplateBinding Content}"
                                                IsEnabled="{Binding IsIndeterminate, Mode=OneWay, Converter={StaticResource ReverseBooleanConverter}}" />
                                            <ProgressBar Height="2"
                                                IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                Maximum="1" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D9EBF9" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="False">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#CCE8FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="64">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16"
                                                Height="16"
                                                Source="{Binding DosyaAdı, IsAsync=True, Converter={StaticResource FilePathToIconConverter}}" />
                                            <Image Width="16" Height="16">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Shell32.dll" />
                                                        <Binding Source="47" />
                                                    </MultiBinding>
                                                </Image.Source>
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Encrypted, Mode=OneWay}" Value="true">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                            <CheckBox Command="{Binding TümünüSeç, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </GridViewColumn>
                        <GridViewColumn Width="110"
                            Extensions:GridViewSort.PropertyName="DosyaAdı"
                            DisplayMemberBinding="{Binding DosyaAdı, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="DOSYA&#xA;ADI" />
                                <Extensions:ButtonedTextBox Width="60"
                                    VerticalContentAlignment="Center"
                                    Background="{x:Null}"
                                    BorderBrush="{x:Null}"
                                    CopyButtonVisibility="Collapsed"
                                    OpenButtonVisibility="Collapsed"
                                    PasteButtonVisibility="Collapsed"
                                    Text="{Binding Search, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </GridViewColumn>
                        <GridViewColumn Width="80"
                            Extensions:GridViewSort.PropertyName="Boyut"
                            DisplayMemberBinding="{Binding Boyut, Mode=OneWay}"
                            Header="BOYUT" />
                        <GridViewColumn Width="80"
                            Extensions:GridViewSort.PropertyName="SıkıştırılmışBoyut"
                            DisplayMemberBinding="{Binding SıkıştırılmışBoyut, Mode=OneWay}"
                            Header="SIKIŞTIRILMIŞ&#xA;BOYUT" />
                        <GridViewColumn Width="70"
                            Extensions:GridViewSort.PropertyName="DosyaTipi"
                            DisplayMemberBinding="{Binding DosyaTipi, Mode=OneWay}">
                            <GridViewColumn.Header>
                                <Extensions:CheckComboBox Width="32"
                                    ItemTemplate="{DynamicResource SimpleArchiveViewerFilterItemTemplate}"
                                    Items="{Binding ArchiveFileTypes, RelativeSource={RelativeSource AncestorType=Extensions:ArchiveViewer}}"
                                    Watermark="TİP" />
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="70"
                            Extensions:GridViewSort.PropertyName="Crc"
                            DisplayMemberBinding="{Binding Crc}"
                            Header="CRC32" />
                        <GridViewColumn Width="70"
                            Extensions:GridViewSort.PropertyName="HostOs"
                            DisplayMemberBinding="{Binding HostOs}"
                            Header="İŞLETİM&#x0a;SİSTEMİ" />
                        <GridViewColumn Width="70"
                            Extensions:GridViewSort.PropertyName="Method"
                            DisplayMemberBinding="{Binding Method}"
                            Header="YÖNTEM" />
                        <GridViewColumn Width="70"
                            Extensions:GridViewSort.PropertyName="Attributes"
                            DisplayMemberBinding="{Binding Attributes}"
                            Header="ÖZNİTELİK" />
                    </GridView>
                </ListView.View>
            </ListView>
            <GridSplitter Grid.Column="1"
                Width="3"
                HorizontalAlignment="Stretch"
                Background="{StaticResource GroupBoxBackGround}" />
            <ContentControl Grid.Column="2"
                Content="{Binding RelativeSource={RelativeSource AncestorType=Extensions:ArchiveViewer}, Path=ThumbFile, Mode=OneWay}"
                ContentTemplateSelector="{DynamicResource SimpleArchiveViewerSelector}" />
            <ProgressBar Grid.Row="1"
                Grid.ColumnSpan="3"
                Height="3"
                Maximum="1"
                Value="{Binding RelativeSource={RelativeSource AncestorType=Extensions:ArchiveViewer}, Path=Progress, Mode=OneWay}" />
            <StatusBar Grid.Row="2" Grid.ColumnSpan="3">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{Binding SelectedFile.DosyaAdı, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}" />
                        <TextBlock Text="{Binding SelectedFile.DüzenlenmeZamanı, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}" />
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <ProgressBar Foreground="{DynamicResource ProgressBarPinkForeground}"
                            IsIndeterminate="{Binding IsBusy, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            Maximum="100"
                            Value="{Binding ToplamOran, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        <TextBlock HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="{Binding ToplamOran, RelativeSource={RelativeSource Mode=TemplatedParent}, StringFormat={}{0:F0}%}" />
                    </Grid>
                </StatusBarItem>
                <StatusBarItem Grid.Column="2">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=Lv, Mode=OneWay}" Value="false">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding CheckedCount, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}" />
                        <System:String>/</System:String>
                        <Run Text="{Binding TotalFilesCount, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Extensions:ArchiveViewer}}}" />
                    </TextBlock>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </ControlTemplate>
    <Style x:Key="SimpleArchiveViewerStyle" TargetType="{x:Type local:SimpleArchiveViewer}">
        <Setter Property="Template" Value="{StaticResource DefaultArchiveViewerTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SimpleStyle, RelativeSource={RelativeSource Mode=Self}}" Value="true">
                <Setter Property="Template" Value="{StaticResource SimpleArchiveViewerTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DrawingBrush x:Key="Dur"
        ice:Freeze="True"
        Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing ice:Freeze="True"
                    Brush="Black"
                    Geometry="F1 M 5.27184,18L 0,12.7282L 0,5.27184L 5.27184,1.90735e-006L 12.7282,1.90735e-006L 18,5.27184L 18,12.7282L 12.7282,18L 5.27184,18 Z " />
                <GeometryDrawing ice:Freeze="True"
                    Brush="White"
                    Geometry="F1 M 5.38416,17.7293L 0.26928,12.6158L 0.26928,5.38416L 5.38416,0.269283L 12.6158,0.270723L 17.7293,5.38416L 17.7293,12.6158L 12.6158,17.7293L 5.38416,17.7293 Z " />
                <GeometryDrawing ice:Freeze="True"
                    Brush="Red"
                    Geometry="F1 M 0.684,12.4445L 0.684,5.55552L 5.55552,0.684002L 12.4445,0.684002L 17.316,5.55552L 17.316,12.4445L 12.4445,17.316L 5.55552,17.316L 0.684,12.4445 Z " />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <ControlTemplate x:Key="ValidationErrorTemplate">
        <Grid Focusable="False">
            <Canvas x:Name="Cnv"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Dur}"
                DataContext="{Binding ElementName=Adorner, Mode=OneWay}"
                RenderTransformOrigin="0.5,0.5"
                UseLayoutRounding="True">
                <Viewbox Width="18" Height="18">
                    <TextBlock Foreground="White">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ResourceLanguageStringConverter}">
                                <Binding Mode="OneWay" Source="STOP" />
                                <Binding Mode="OneWay" Path="Tag.Scanner.UiLanguage" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Viewbox>
                <Canvas.ToolTip>
                    <ToolTip Background="{x:Null}"
                        BorderBrush="{x:Null}"
                        Foreground="{x:Null}">
                        <Border Padding="4"
                            Background="Red"
                            BorderBrush="White"
                            BorderThickness="1">
                            <TextBlock Foreground="White">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ResourceLanguageStringConverter}">
                                        <Binding Mode="OneWay" Path="DataContext[0].ErrorContent" />
                                        <Binding Mode="OneWay" Path="Tag.Scanner.UiLanguage" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </ToolTip>
                </Canvas.ToolTip>
            </Canvas>
            <AdornedElementPlaceholder x:Name="Adorner" Tag="{Binding RelativeSource={RelativeSource AncestorType=local:TwainCtrl}}" />
        </Grid>
    </ControlTemplate>
    <DrawingBrush x:Key="Qr" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing ice:Freeze="True"
                        Brush="#FFFFFFFF"
                        Geometry="F1 M 0.5,0.500001L 16.5,0.500001L 16.5,16.5L 0.5,16.5L 0.5,0.500001 Z ">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF000000" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing ice:Freeze="True"
                        Brush="#FFFFFFFF"
                        Geometry="F1 M 8.5,0.947958L 8.5,16.6043">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF000000" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing ice:Freeze="True"
                        Brush="#FFFFFFFF"
                        Geometry="F1 M 0.979165,8.5L 16.9805,8.5">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF000000" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Colorfull" ice:Freeze="true" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0.0" Color="Red" />
        <GradientStop Offset="0.17" Color="Orange" />
        <GradientStop Offset="0.33" Color="Yellow" />
        <GradientStop Offset="0.5" Color="Green" />
        <GradientStop Offset="0.67" Color="Blue" />
        <GradientStop Offset="0.83" Color="Indigo" />
        <GradientStop Offset="1.0" Color="Violet" />
    </LinearGradientBrush>
    <ObjectDataProvider x:Key="PdfLayout"
        MethodName="GetValues"
        ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="local:PdfPageLayout" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="PdfDashLayout"
        MethodName="GetValues"
        ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="pdfsharpdrawing:XDashStyle" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="PdfPenLineLayout"
        MethodName="GetValues"
        ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="pdfsharpdrawing:XLineCap" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="PdfPenLineJoinLayout"
        MethodName="GetValues"
        ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="pdfsharpdrawing:XLineJoin" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="PdfColor"
        MethodName="GetValues"
        ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="pdfsharpdrawing:XKnownColor" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="InkCanvasEditingMode"
        MethodName="GetValues"
        ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="InkCanvasEditingMode" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StylusTip"
        MethodName="GetValues"
        ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="StylusTip" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="LinearFillMode"
        MethodName="GetValues"
        ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="pdfsharpdrawing:XLinearGradientMode" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <DrawingBrush x:Key="Despeckle"
        ice:Freeze="true"
        Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing ice:Freeze="true"
                        Brush="#FFFFFFFF"
