    <Style TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Name="Panel">
                        <ContentPresenter Margin="10,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Panel" Property="Background" Value="{StaticResource GroupBoxBackGround}" />
                            <Setter TargetName="Panel" Property="BorderBrush" Value="Black" />
                            <Setter TargetName="Panel" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="Panel" Property="Background" Value="{StaticResource BorderBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NumericUpDownStyle" TargetType="{x:Type Extensions:NumericUpDown}">
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Extensions:NumericUpDown}">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <RepeatButton x:Name="PART_UpButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Command="{Binding NumberIncrease, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            FontFamily="Wingdings 3"
                            FontSize="12"
                            FontWeight="Bold">
                            <Image Width="16"
                                Height="16"
                                Source="/TwainControl;component/Icons/rotate.png" />
                        </RepeatButton>
                        <TextBox x:Name="PART_TextBox"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Foreground="{TemplateBinding Foreground}"
                            IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            Text="{Binding ContentText, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            Visibility="{Binding NumericUpdownTextBoxVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
                        <RepeatButton x:Name="PART_DownButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Command="{Binding NumberDecrease, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            FontFamily="Wingdings 3"
                            FontSize="12"
                            FontWeight="Bold">
                            <Image Width="16"
                                Height="16"
                                Source="/TwainControl;component/Icons/left.png" />
                        </RepeatButton>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_UpButton" Property="Background" Value="Gray" />
                            <Setter TargetName="PART_DownButton" Property="Background" Value="Gray" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_DownButton" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_TextBox" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_UpButton" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_UpButton" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_TextBox" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_DownButton" Property="Grid.Row" Value="2" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_DownButton" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_TextBox" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_UpButton" Property="Grid.Column" Value="2" />
                            <Setter TargetName="PART_TextBox" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_DownButton" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_UpButton" Property="Grid.Row" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="false" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Name="ScrollButtonBorder" Background="Transparent">
                        <Path Name="ScrollButtonPath"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}"
                            Fill="{StaticResource ThumbBarSolidBackground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ScrollButtonPath" Property="Fill" Value="{StaticResource ThumbBarSolidBackground_MouseMove}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ScrollButtonPath" Property="Fill" Value="{StaticResource ThumbBarSolidBackground_Draging}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
