            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Extensions:SplitButton Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    Command="{Binding PrintEypPackageSelectedDocuments}"
                    CommandParameter="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                    Content="7"
                    FontFamily="Wingdings 2"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                    InternalContent="{StaticResource EypPrintSplitButtonInternalContent}" />
                <TextBlock>
                    <Hyperlink Command="{Binding PdfViewerFullScreen}"
                        CommandParameter="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                        TextDecorations="None">
                        <Run FontFamily="Wingdings 2"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="4" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink BaselineAlignment="Center"
                        Command="{Binding MergePdfListRemoveFile}"
                        CommandParameter="{Binding DataContext, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                        TextDecorations="None">
                        <Image Width="24"
                            Height="24"
                            Source="/TwainControl;component/Icons/delete.png" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <PdfViewer:PdfShadowedImage Grid.Row="1"
                Width="210"
                Height="297"
                Source="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag.Result, IsAsync=True}">
                <PdfViewer:PdfShadowedImage.Resources>
                    <PdfViewer:PdfPageToThumbImageConverter x:Key="PdfPageToThumbImageConverter" Dpi="36" />
                </PdfViewer:PdfShadowedImage.Resources>
                <PdfViewer:PdfShadowedImage.Tag>
                    <MultiBinding Converter="{StaticResource PdfPageToThumbImageConverter}">
                        <Binding Mode="OneWay"
                            Path="DataContext"
                            RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                        <Binding Mode="OneWay">
                            <Binding.Source>
                                <System:Int32>1</System:Int32>
                            </Binding.Source>
                        </Binding>
                        <Binding Mode="OneWay" Path="RefreshDocumentList" />
                    </MultiBinding>
                </PdfViewer:PdfShadowedImage.Tag>
            </PdfViewer:PdfShadowedImage>
            <TextBlock Grid.Row="1"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="64"
                Foreground="Red"
                IsHitTestVisible="False"
                Opacity="0.5"
                RenderTransformOrigin="0.5,0.5"
                Tag="{Binding Path=DataContext, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource PdfPageCountConverter}}"
                Text="{Binding Mode=OneWay, IsAsync=True, Path=Tag.Result, RelativeSource={RelativeSource Mode=Self}}">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="315" />
                        <TranslateTransform />
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </DataTemplate>
