                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ThumbBarSolidBackground_MouseMove}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ThumbBarSolidBackground_Draging}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
