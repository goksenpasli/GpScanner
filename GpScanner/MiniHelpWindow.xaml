<UserControl x:Class="GpScanner.MiniHelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GpScanner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:GpScanner.ViewModel"
    Width="350"
    d:DataContext="{d:DesignInstance Type=viewmodel:GpScannerViewModel}"
    d:DesignHeight="450"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <FlowDocumentScrollViewer VerticalScrollBarVisibility="Disabled">
        <FlowDocument>
            <Paragraph>
                <TextBlock>
                    <Run BaselineAlignment="Center" Text=".NET Framework 4.8 Installed" />
                    <InlineUIContainer BaselineAlignment="Center">
                        <Image Width="16" Height="16">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                <Binding Source="Comres.dll" />
                                                <Binding Source="10" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NetFxVersionSupported}" Value="true">
                                            <Setter Property="Source">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Comres.dll" />
                                                        <Binding Source="8" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </InlineUIContainer>
                </TextBlock>
                <TextBlock>
                    <Run BaselineAlignment="Center" Text="Visual C++ 2019 Runtime Installed" />
                    <InlineUIContainer BaselineAlignment="Center">
                        <Image Width="16" Height="16">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                <Binding Source="Comres.dll" />
                                                <Binding Source="10" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TesseractVisualCRuntimeInstalled}" Value="true">
                                            <Setter Property="Source">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Comres.dll" />
                                                        <Binding Source="8" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </InlineUIContainer>
                </TextBlock>
                <TextBlock>
                    <Run BaselineAlignment="Center" Text="Tesseract Language Selected" />
                    <InlineUIContainer BaselineAlignment="Center">
                        <Image Width="16" Height="16">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                <Binding Source="Comres.dll" />
                                                <Binding Source="10" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TesseractAnyLanguageSelected}" Value="true">
                                            <Setter Property="Source">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Comres.dll" />
                                                        <Binding Source="8" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </InlineUIContainer>
                </TextBlock>
                <TextBlock>
                    <Run BaselineAlignment="Center" Text="Tesseract Orientation Language Available" />
                    <InlineUIContainer BaselineAlignment="Center">
                        <Image Width="16" Height="16">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                <Binding Source="Comres.dll" />
                                                <Binding Source="10" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TesseractOrientationLanguageAvailable}" Value="true">
                                            <Setter Property="Source">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Comres.dll" />
                                                        <Binding Source="8" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </InlineUIContainer>
                </TextBlock>
            </Paragraph>
        </FlowDocument>
    </FlowDocumentScrollViewer>
</UserControl>
