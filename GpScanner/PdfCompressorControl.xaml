<UserControl x:Class="GpScanner.PdfCompressorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Compressor="clr-namespace:PdfCompressor;assembly=PdfCompressor"
    xmlns:Converter="clr-namespace:TwainControl.Converter;assembly=TwainControl"
    xmlns:Extensions="clr-namespace:Extensions;assembly=Extensions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mozjpeg="clr-namespace:MozJpeg;assembly=MozJpeg"
    xmlns:twainctrl="clr-namespace:TwainControl;assembly=TwainControl"
    xmlns:twainproperties="clr-namespace:TwainControl.Properties;assembly=TwainControl"
    xmlns:viewmodel="clr-namespace:GpScanner.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:GpScannerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    twainctrl:Translation.ResourceManager="{x:Static twainproperties:Resources.ResourceManager}"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Extensions:SystemFileIconConverter x:Key="SystemFileIconConverter" />
        <Converter:NumberRangeToColorConverter x:Key="NumberRangeToColorConverter"
            MaxNumber="1200"
            MinNumber="12" />
        <Converter:NumberRangeToColorConverter x:Key="NumberQualityRangeToColorConverter"
            MaxNumber="100"
            MinNumber="1"
            ReverseColors="True" />
        <DataTemplate x:Key="ListBoxItemListTemplate">
            <CheckBox IsChecked="{Binding IsChecked}">
                <Extensions:ButtonedTextBox VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    CancelCommand="{Binding RemovePdfFile, RelativeSource={RelativeSource AncestorType={x:Type Compressor:Compressor}}}"
                    CancelCommandParameter="{Binding Mode=OneWay}"
                    CopyButtonVisibility="Collapsed"
                    Focusable="False"
                    Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                    PasteButtonVisibility="Collapsed"
                    Text="{Binding Filename, Mode=OneWay}"
                    TextBoxVisibility="Collapsed">
                    <TextBlock><InlineUIContainer BaselineAlignment="Center">
                            <ProgressBar Width="32"
                                Height="12"
                                Margin="1"
                                Background="{x:Null}"
                                Maximum="100"
                                Value="{Binding CompressionRatio, Mode=OneWay}" />
                        </InlineUIContainer><Run BaselineAlignment="Center" Text="{Binding Filename, Mode=OneWay}" /></TextBlock>
                </Extensions:ButtonedTextBox>
            </CheckBox>
        </DataTemplate>
        <Style x:Key="CompressorStyle" TargetType="{x:Type Compressor:Compressor}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Compressor:Compressor}">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0"
                                    Grid.Column="0"
                                    Rows="3">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Dpi, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                        <Run Text="DPI" />
                                    </TextBlock>
                                    <Slider AutoToolTipPlacement="TopLeft"
                                        AutomationProperties.Name="{twainctrl:Loc JPEGQUALITY}"
                                        Background="{Binding Dpi, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource NumberRangeToColorConverter}}"
                                        IsSnapToTickEnabled="True"
                                        Maximum="4800"
                                        Minimum="12"
                                        SmallChange="1"
                                        Style="{DynamicResource Slider}"
                                        Ticks="12,24,36,48,72,96,120,150,200,300,450,600,1200,2400,4800"
                                        Value="{Binding Dpi, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{twainctrl:Loc JPEGQUALITY}" />
                                        <Run Text="{Binding Quality, Mode=OneWay, StringFormat={}{0}%, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                    </TextBlock>
                                    <Slider AutoToolTipPlacement="TopLeft"
                                        Background="{Binding Quality, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource NumberQualityRangeToColorConverter}}"
                                        LargeChange="1"
                                        Maximum="100"
                                        Minimum="1"
                                        SmallChange="1"
                                        Style="{DynamicResource Slider}"
                                        Value="{Binding Quality, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox AutomationProperties.Name="{twainctrl:Loc JPEGQUALITY}"
                                        ItemsSource="{Binding CompressorList}"
                                        SelectedItem="{Binding Path=SelectedCompressorProfile, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="ComboBox_CompressorListSourceUpdated">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Width, Mode=OneWay}" />
                                                    <Run Text="DPI" />
                                                    <Run Text="{Binding Height, Mode=OneWay, StringFormat={}{0}%}" />
                                                    <Run Text="{twainctrl:Loc JPEGQUALITY}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button AutomationProperties.Name="{twainctrl:Loc CLEARLIST}"
                                        Command="{Binding ClearPdfCompressorBatchList}"
                                        CommandParameter="{Binding BatchPdfList, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        IsEnabled="{Binding CompressFinished, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16" Height="16">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Shell32.dll" />
                                                        <Binding Source="131" />
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run AutomationProperties.Name="{twainctrl:Loc ALL}" Text="{twainctrl:Loc ALL}" />
                                                <Run Text="{twainctrl:Loc CLEARLIST}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <StackPanel Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    IsEnabled="{Binding BatchProcessIsEnabled, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    Orientation="Horizontal">
                                    <Button Command="{Binding OpenBatchPdfFolder, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <Image Width="24" Height="24">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Shell32.dll" />
                                                    <Binding Source="19" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Button>
                                    <Button VerticalContentAlignment="Stretch"
                                        Command="{Binding BatchCompressFile, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        IsEnabled="{Binding CompressFinished, NotifyOnTargetUpdated=True, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        TargetUpdated="CompressFinishedButton_TargetUpdated">
                                        <Grid>
                                            <ProgressBar Background="{x:Null}"
                                                BorderBrush="{x:Null}"
                                                Maximum="1"
                                                Minimum="0"
                                                Orientation="Vertical"
                                                Value="{Binding CompressionProgress, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                            <Image Width="24" Height="24">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Zipfldr.dll" />
                                                        <Binding Source="0" />
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <ListBox x:Name="ListBox"
                                            Margin="20,0,0,0"
                                            d:ItemTemplate="{StaticResource ListBoxItemListTemplate}"
                                            d:ItemsSource="{d:SampleData ItemCount=5}"
                                            Background="{DynamicResource GroupBoxBackGround}"
                                            BorderBrush="{x:Null}"
                                            IsEnabled="{Binding BatchProcessIsEnabled, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            ItemsSource="{Binding BatchPdfList, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            VirtualizingPanel.CacheLengthUnit="Pixel"
                                            VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                            VirtualizingPanel.ScrollUnit="Pixel"
                                            VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem AutomationProperties.Name="{twainctrl:Loc ALL}"
                                                        Command="{Binding Parent.Parent.SelectAllFile, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                        Header="{twainctrl:Loc ALL}">
                                                        <MenuItem.Icon>
                                                            <Image Width="16"
                                                                Height="16"
                                                                Source="/TwainControl;component/Icons/selectall.png" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem AutomationProperties.Name="{twainctrl:Loc NONE}"
                                                        Command="{Binding Parent.Parent.DeselectAllFile, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                        Header="{twainctrl:Loc NONE}">
                                                        <MenuItem.Icon>
                                                            <Image Width="16"
                                                                Height="16"
                                                                Source="/TwainControl;component/Icons/none.png" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem AutomationProperties.Name="{twainctrl:Loc REVERSE}"
                                                        Command="{Binding Parent.Parent.InverseSelectFile, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                        Header="{twainctrl:Loc REVERSE}">
                                                        <MenuItem.Icon>
                                                            <Image Width="16"
                                                                Height="16"
                                                                Source="/TwainControl;component/Icons/inverse.png" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Completed}" Value="true">
                                                            <Setter Property="Background" Value="Green" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PdfCompressorItemToggle, Mode=OneWay}" Value="true">
                                                            <Setter Property="ItemTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding IsChecked}">
                                                                            <ContentControl Width="150"
                                                                                Height="150"
                                                                                Content="{Binding IsAsync=True, Mode=OneWay, Path=Filename}"
                                                                                ContentTemplateSelector="{StaticResource DocumentViewerMiniSelector}" />
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="ItemsPanel">
                                                                <Setter.Value>
                                                                    <ItemsPanelTemplate>
                                                                        <Extensions:VirtualizingWrapPanel CanHorizontallyScroll="False"
                                                                            ItemSize="165,165"
                                                                            SpacingMode="None" />
                                                                    </ItemsPanelTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PdfCompressorItemToggle, Mode=OneWay}" Value="false">
                                                            <Setter Property="ItemTemplate" Value="{StaticResource ListBoxItemListTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                        </ListBox>
                                        <ToggleButton HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            IsChecked="{Binding PdfCompressorItemToggle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ElementName=ListBox, Path=HasItems, Mode=OneWay}">
                                            <Image Width="16" Height="16">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                        <Binding Source="Shell32.dll" />
                                                        <Binding Source="19" />
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </ToggleButton>
                                    </Grid>
                                    <GridSplitter Grid.Column="1"
                                        Width="3"
                                        HorizontalAlignment="Stretch"
                                        Background="{DynamicResource BorderBackground}" />
                                    <ContentControl Grid.Column="2"
                                        Content="{Binding SelectedItem.Filename, ElementName=ListBox, IsAsync=True, Mode=OneWay}"
                                        ContentTemplateSelector="{StaticResource DvdBurnerDocumentViewerSelector}" />
                                </Grid>
                                <Separator Grid.Row="2" Grid.ColumnSpan="2" />
                                <UniformGrid Grid.Row="3"
                                    Columns="2"
                                    IsEnabled="{Binding CompressFinished, ElementName=Compressor}">
                                    <CheckBox VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Content="PDF MOZJPEG"
                                        IsChecked="{Binding UseMozJpeg, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        IsEnabled="{Binding Source={x:Static mozjpeg:MozJpeg.MozJpegDllExists}}" />
                                    <CheckBox VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        AutomationProperties.Name="{twainctrl:Loc BW}"
                                        IsChecked="{Binding BlackAndWhite, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <TextBlock>
                                            <Run Text="PDF" />
                                            <Run Text="{twainctrl:Loc BW}" />
                                        </TextBlock>
                                    </CheckBox>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Compressor:Compressor x:Name="Compressor"
            BatchPdfList="{Binding CompressedFiles}"
            Style="{StaticResource CompressorStyle}" />
    </Grid>
</UserControl>
