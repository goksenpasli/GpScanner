                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Image Width="256"
                            Height="256"
                            HorizontalAlignment="Left"
                            Source="{Binding Converter={StaticResource JumboSizeFilePathToIconConverter}, Source=.dll}" />
                        <Grid Width="680" HorizontalAlignment="Right">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="150" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="2">
                                <ComboBox DisplayMemberPath="[1]"
                                    ItemsSource="{Binding SampleSqlQueryLists}"
                                    SelectedValue="{Binding SqlText}"
                                    SelectedValuePath="[1]" />
                                <CheckBox VerticalAlignment="Center"
                                    d:Content="SQL QUERY"
                                    IsChecked="{Binding IsSqlQuery}">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSqlQuery}" Value="True">
                                                    <Setter Property="Content" Value="SQL QUERY" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSqlQuery}" Value="False">
                                                    <Setter Property="Content" Value="SQL COMMAND" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </UniformGrid>
                            <Extensions:ButtonedTextBox Grid.Row="1"
                                d:Text="SqlText"
                                AcceptsReturn="True"
                                Background="{StaticResource BorderBackground}"
                                BorderBrush="{StaticResource GroupBoxBackGround}"
                                FontSize="16"
                                FontSizeButtonVisibility="Visible"
                                OpenButtonVisibility="Collapsed"
                                Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                TextWrapping="Wrap"
                                Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                                VerticalScrollBarVisibility="Auto" />
                            <DataGrid Grid.Row="2"
                                d:ItemsSource="{d:SampleData ItemCount=5}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="True"
                                IsReadOnly="True"
                                ItemsSource="{Binding SqlQueryData}"
                                VirtualizingPanel.CacheLengthUnit="Item"
                                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{twainctrl:Loc FILENAME}" SortMemberPath="FileName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Extensions:ButtonedTextBox VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Description="{Binding FileName, Mode=OneWay, Converter={StaticResource FileNameExtractConverter}}"
                                                    IsReadOnly="True"
                                                    PasteButtonVisibility="Collapsed"
                                                    ResetButtonVisibility="Collapsed"
                                                    SelectionBrush="DarkMagenta"
                                                    Text="{Binding FileName, Mode=OneWay}"
                                                    TextBoxVisibility="Collapsed" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="QR" SortMemberPath="QrData">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image MaxWidth="80"
                                                    MaxHeight="80"
                                                    d:Source="{Binding Source='GPSCANNER', Mode=OneWay, Converter={StaticResource StringToQrBitmapImageConverter}}"
                                                    Source="{Binding QrData, Mode=OneWay, Converter={StaticResource StringToQrBitmapImageConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="300" Header="{twainctrl:Loc CONTENT}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Extensions:ButtonedTextBox Background="{x:Null}"
                                                    BorderBrush="{x:Null}"
                                                    Command="{Binding DataContext.ExploreFile, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Mode=OneWay, Path=FileName}"
                                                    CopyButtonVisibility="Collapsed"
                                                    IsReadOnly="True"
                                                    PasteButtonVisibility="Collapsed"
                                                    PrintButtonVisibility="Visible"
                                                    ResetButtonVisibility="Collapsed"
                                                    Text="{Binding FileContent, IsAsync=True, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
