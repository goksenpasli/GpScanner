                                                <Hyperlink BaselineAlignment="Center"
                                                    Command="{Binding DataContext.RemoveEsclScanner, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding Mode=OneWay}"
                                                    TextDecorations="None">
                                                    <InlineUIContainer BaselineAlignment="Center">
                                                        <Image Width="16"
                                                            Height="16"
                                                            Source="/TwainControl;component/Icons/delete.png" />
                                                    </InlineUIContainer>
                                                </Hyperlink><Run d:Text="Profile"
                                                    BaselineAlignment="Center"
                                                    Text="{Binding Mode=OneWay}" /></TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </UniformGrid>
                </AdornerDecorator>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="32"
                            Height="32"
                            Source="{Binding Source='GPSCANNER', Mode=OneWay, Converter={StaticResource StringToQrBitmapImageConverter}}" />
                        <TextBlock VerticalAlignment="Center" Text="{twainctrl:Loc QRDETECT}" />
                    </StackPanel>
                </TabItem.Header>
                <GroupBox>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <CheckBox VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            twainctrl:Policy.PolicyName="DetectBarCode"
