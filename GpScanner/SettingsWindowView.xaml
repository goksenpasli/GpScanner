                                                    <Run Text="{twainctrl:Loc DELETE}" />
                                                </Hyperlink></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Image x:Name="Img"
                                d:Source="{Binding Source='Gok$en', Converter={StaticResource StringToQrBitmapImageConverter}, Mode=OneWay}"
