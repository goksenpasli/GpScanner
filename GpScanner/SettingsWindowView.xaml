<Window x:Class="GpScanner.SettingsWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converter="clr-namespace:GpScanner.Converter"
    xmlns:Extensions="clr-namespace:Extensions;assembly=Extensions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GpScanner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:GpScanner.Properties"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:twainctrl="clr-namespace:TwainControl;assembly=TwainControl"
    xmlns:twainproperties="clr-namespace:TwainControl.Properties;assembly=TwainControl"
    xmlns:viewmodel="clr-namespace:GpScanner.ViewModel"
    Title="GPSCANNER"
    Width="960"
    Height="600"
    d:DataContext="{d:DesignInstance Type=viewmodel:GpScannerViewModel}"
    twainctrl:Translation.ResourceManager="{x:Static twainproperties:Resources.ResourceManager}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0.8"
                        To="1"
                        Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Converter:StringToQrBitmapImageConverter x:Key="StringToQrBitmapImageConverter" />
        <Converter:PdfFileNameToInfoConverter x:Key="PdfFileNameToInfoConverter" IsEnabled="True" />
        <Converter:NumberRangeToColorConverter x:Key="ComboBoxNumberRangeToColorConverter"
            MaxNumber="100"
            MinNumber="5" />
        <Converter:NumberRangeToColorConverter x:Key="UpdateNumberRangeToColorConverter"
            MaxNumber="120"
            MinNumber="1" />
        <Converter:NumberRangeToColorConverter x:Key="ComboBoxPdfNumberRangeToColorConverter"
            MaxNumber="1200"
            MinNumber="12" />
        <Extensions:StringNullableToBooleanConverter x:Key="StringNullableToBooleanConverter" />
        <Extensions:FilePathToIconConverter x:Key="JumboSizeFilePathToIconConverter" IconSize="jumbo" />
        <Extensions:ReverseBooleanConverter x:Key="ReverseBooleanConverter" />
        <Converter:PageSizePreviewWidthConverter x:Key="PageSizePreviewWidthConverter" />
        <Converter:StringToCountryFlagImageConverter x:Key="StringToCountryFlagImageConverter" />
        <Converter:PageSizePreviewHeightConverter x:Key="PageSizePreviewHeightConverter" />
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Template" Value="{StaticResource ComboBoxStyle}" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownStyle}" TargetType="Extensions:NumericUpDown" />
        <viewmodel:RippleEffect x:Key="FlagRippleEffect" Progress="{Binding FlagProgress}" />
        <Image x:Key="tick"
            Width="16"
            Height="16"
            x:Shared="false"
            Visibility="{Binding Mode=OneWay, Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image.Source>
                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                    <Binding Source="Comres.dll" />
                    <Binding Source="8" />
                </MultiBinding>
            </Image.Source>
        </Image>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Pause" Command="{Binding StopFlagAnimation}" />
    </Window.InputBindings>
    <Grid>
        <TabControl Background="{StaticResource BorderBackground}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="32" Height="32">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                    <Binding Source="Shell32.dll" />
                                    <Binding Source="21" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <TextBlock VerticalAlignment="Center" Text="{twainctrl:Loc SETTİNGS}" />
                    </StackPanel>
                </TabItem.Header>
                <AdornerDecorator>
                    <Grid Background="{StaticResource BorderBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>
                        <GroupBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="11*" />
                                    <ColumnDefinition Width="5*" />
                                </Grid.ColumnDefinitions>
                                <ListBox Margin="1"
                                    VerticalContentAlignment="Center"
                                    d:SelectedValue="TÜRKÇE"
                                    twainctrl:Policy.PolicyName="SeçiliDil"
                                    Background="{StaticResource BorderBackground}"
                                    PreviewKeyDown="ListBox_PreviewKeyDown"
                                    SelectedValue="{Binding SeçiliDil}"
                                    SelectedValuePath="Key">
                                    <ListBox.ItemsSource>
                                        <CompositeCollection>
                                            <CollectionContainer Collection="{x:Static viewmodel:SplashViewModel.LanguageFlags}" />
                                            <ListBoxItem Cursor="No" Focusable="False">
                                                <Canvas Width="70" Height="60">
                                                    <Canvas.Resources>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Canvas.Resources>
                                                    <Image Width="70" Source="/Resources/Flag_of_Israel.png" />
                                                    <Grid Width="70" Height="60">
                                                        <Image Width="50"
                                                            Height="40"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Source="/Resources/blood.png" />
                                                        <Image Width="50"
                                                            Height="40"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            Source="/Resources/blood.png">
                                                            <Image.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform ScaleX="-1" />
                                                                    <SkewTransform />
                                                                    <RotateTransform />
                                                                    <TranslateTransform />
                                                                </TransformGroup>
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </Grid>
                                                    <TextBlock Canvas.Bottom="0"
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Text="עִברִית" />
                                                </Canvas>
                                            </ListBoxItem>
                                        </CompositeCollection>
                                    </ListBox.ItemsSource>
                                    <ListBox.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource ListBoxItemTemplate}" TargetType="ListBoxItem">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="Margin" Value="1,0,1,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform d:ScaleX="1" d:ScaleY="1" ScaleX="0" ScaleY="0" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter Property="VerticalContentAlignment" Value="Top" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BorderBackground}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GroupBoxBackGround}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1F26A0DA" />
                                                    <Setter Property="BorderBrush" Value="#A826A0DA" />
                                                </Trigger>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                From="0"
                                                                To="1"
                                                                Duration="0:0:0.2" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                From="0"
                                                                To="1"
                                                                Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Extensions:VirtualizingWrapPanel SpacingMode="None" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="70" Height="60">
                                                <Image Width="70"
                                                    Effect="{StaticResource FlagRippleEffect}"
                                                    FlowDirection="LeftToRight"
                                                    Source="{Binding Key, Converter={StaticResource StringToCountryFlagImageConverter}}">
                                                    <Image.CacheMode>
                                                        <BitmapCache RenderAtScale="1.5" />
                                                    </Image.CacheMode>
                                                </Image>
                                                <TextBlock Canvas.Bottom="0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{Binding Mode=OneWay, Path=Key}" />
                                                <ContentPresenter Content="{StaticResource tick}" />
                                            </Canvas>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{x:Null}"
                                    BorderBrush="{x:Null}"
                                    Command="{Binding StopFlagAnimation}"
                                    Content="n"
                                    FontFamily="Wingdings"
                                    FontSize="16"
                                    ToolTip="{twainctrl:Loc STOP}" />
                                <local:TesseractView Grid.Column="1" Margin="1" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Extensions:FileBreadCrumbControl FilePath="{Binding DatabaseFile, Mode=OneWay, Source={x:Static properties:Settings.Default}}"
                                    InternalBackground="{StaticResource BorderBackground}"
                                    ShowFileName="Visible" />
                                <Button Grid.Column="1"
                                    twainctrl:Policy.PolicyName="ChangeDataFolder"
                                    Command="{Binding ChangeDataFolder}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="24" Height="24">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                    <Binding Source="Imageres.dll" />
                                                    <Binding Source="8" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock VerticalAlignment="Center" Text="{twainctrl:Loc FILE}" />
                                    </StackPanel>
                                </Button>
                                <ComboBox Grid.Column="2"
                                    VerticalContentAlignment="Center"
                                    SelectedValue="{Binding Path=AnimationType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{twainctrl:Loc FOLD}" Tag="0" />
                                    <ComboBoxItem Content="{twainctrl:Loc RIPPLE}" Tag="1" />
                                    <ComboBoxItem Content="{twainctrl:Loc MIRROR}" Tag="2" />
                                    <ComboBoxItem Content="{twainctrl:Loc NONE}" Tag="3" />
                                </ComboBox>
                                <Button Grid.Column="3" Command="{Binding PlayAnimation}">
                                    <Image Width="16" Height="16">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                <Binding Source="Shell32.dll" />
                                                <Binding Source="137" />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Button>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="2">
                            <StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                    Template="{StaticResource HorizontalScrollViewerTemplate}"
                                    VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                            <Run Text="{twainctrl:Loc FILE}" />
                                            <Run Text="{twainctrl:Loc RES}" />
                                        </TextBlock>
                                        <ComboBox VerticalContentAlignment="Center"
                                            twainctrl:Policy.PolicyName="DefaultPictureResizeRatio"
                                            ItemStringFormat="{}{0}%"
                                            ItemsSource="{Binding SettingsPagePictureResizeList}"
                                            SelectedItem="{Binding DefaultPictureResizeRatio, Mode=TwoWay, Source={x:Static twainproperties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{twainctrl:Loc CONTENT}" />
                                                    <Run Text="{twainctrl:Loc RES}" />
                                                    <Run Text="{Binding DefaultPictureResizeRatio, Mode=OneWay, Source={x:Static twainproperties:Settings.Default}, StringFormat={}{0}%}" />
                                                </TextBlock>
                                            </ComboBox.ToolTip>
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="{Binding Mode=OneWay, Converter={StaticResource ComboBoxNumberRangeToColorConverter}}" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                        <TextBlock VerticalAlignment="Center"
                                            Text="{twainctrl:Loc PREVIEWFILE}"
                                            TextWrapping="Wrap" />
                                        <CheckBox VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            IsChecked="{Binding DefaultThumbPictureAutoResize, Mode=TwoWay, Source={x:Static twainproperties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBlock IsEnabled="{Binding DefaultThumbPictureAutoResize, Mode=OneWay, Source={x:Static twainproperties:Settings.Default}}" TextAlignment="Center">
                                                <Run BaselineAlignment="Center" Text="{twainctrl:Loc Auto}" />
                                                <LineBreak />
                                                <InlineUIContainer BaselineAlignment="Center">
                                                    <Extensions:NumericUpDown VerticalAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Maximum="512"
                                                        Minimum="96"
                                                        Value="{Binding AutomaticThumbSize, Mode=TwoWay, Source={x:Static twainproperties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}" />
                                                </InlineUIContainer>
                                                <TextBlock VerticalAlignment="Center" Text="px" />
                                            </TextBlock>
                                        </CheckBox>
                                        <ComboBox VerticalContentAlignment="Center"
                                            twainctrl:Policy.PolicyName="DefaultThumbPictureResizeRatio"
                                            IsEnabled="{Binding DefaultThumbPictureAutoResize, Mode=OneWay, Source={x:Static twainproperties:Settings.Default}, Converter={StaticResource ReverseBooleanConverter}}"
                                            ItemStringFormat="{}{0}%"
                                            ItemsSource="{Binding SettingsPagePictureResizeList}"
                                            SelectedItem="{Binding DefaultThumbPictureResizeRatio, Mode=TwoWay, Source={x:Static twainproperties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{twainctrl:Loc CONTENT}" />
                                                    <Run Text="{twainctrl:Loc RES}" />
                                                    <Run Text="{Binding DefaultThumbPictureResizeRatio, Mode=OneWay, Source={x:Static twainproperties:Settings.Default}, StringFormat={}{0}%}" />
                                                </TextBlock>
                                            </ComboBox.ToolTip>
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="{Binding Mode=OneWay, Converter={StaticResource ComboBoxNumberRangeToColorConverter}}" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                            <sys:String>PDF</sys:String>
                                            <Run Text="{twainctrl:Loc PREVIEWFILE}" />
                                        </TextBlock>
                                        <ComboBox VerticalContentAlignment="Center"
                                            twainctrl:Policy.PolicyName="DefaultThumbNailDpi"
                                            ItemStringFormat="{}{0} Dpi"
                                            ItemsSource="{Binding SettingsPagePdfDpiList}"
                                            SelectedItem="{Binding DefaultThumbNailDpi, Mode=TwoWay, Source={x:Static properties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="{Binding Mode=OneWay, Converter={StaticResource ComboBoxPdfNumberRangeToColorConverter}}" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                        <Extensions:ContentToggleButton twainctrl:Policy.PolicyName="MinimizeTray">
                                            <Grid>
                                                <Image Width="32" Height="32">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                            <Binding Source="Shell32.dll" />
                                                            <Binding Source="97" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <Image Width="32" Height="32">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                            <Binding Source="Shell32.dll" />
                                                            <Binding Source="123" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                            <Extensions:ContentToggleButton.OverContent>
                                                <Border Background="{StaticResource BorderBackground}"
                                                    BorderBrush="{StaticResource GroupBoxBackGround}"
                                                    BorderThickness="1">
                                                    <StackPanel>
                                                        <MenuItem Header="{twainctrl:Loc SHOWTRAYICON}"
                                                            IsCheckable="True"
                                                            IsChecked="{Binding ShowTrayIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
                                                        <MenuItem Header="{twainctrl:Loc MINTOTRAY}"
                                                            IsCheckable="True"
                                                            IsChecked="{Binding MinimizeTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}"
                                                            IsEnabled="{Binding ShowTrayIcon, Mode=OneWay, Source={x:Static properties:Settings.Default}}" />
                                                        <MenuItem IsCheckable="True" IsChecked="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}">
                                                            <MenuItem.Header>
                                                                <TextBlock>
                                                                    <Run Text="{twainctrl:Loc Auto}" />
                                                                    <Run Text="{twainctrl:Loc RUN}" />
                                                                </TextBlock>
                                                            </MenuItem.Header>
                                                        </MenuItem>
                                                        <MenuItem Header="{twainctrl:Loc SHOWSPLASH}"
                                                            IsCheckable="True"
                                                            IsChecked="{Binding ShowSplash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
                                                    </StackPanel>
                                                </Border>
                                            </Extensions:ContentToggleButton.OverContent>
                                        </Extensions:ContentToggleButton>
                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                        <CheckBox VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            twainctrl:Policy.PolicyName="PlayNotificationAudio"
                                            IsChecked="{Binding PlayNotificationAudio, Mode=TwoWay, Source={x:Static twainproperties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}">
                                            <CheckBox.ToolTip>
                                                <TextBlock FontWeight="Bold"
                                                    Foreground="Red"
                                                    Text="{twainctrl:Loc PLAYSOUND}" />
                                            </CheckBox.ToolTip>
                                            <Extensions:ContentToggleButton ArrowVisibility="Collapsed" IsEnabled="{Binding PlayNotificationAudio, Mode=OneWay, Source={x:Static twainproperties:Settings.Default}}">
                                                <Canvas Width="32" Height="32">
                                                    <Image Width="32" Height="32">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                                <Binding Source="Shell32.dll" />
                                                                <Binding Source="201" />
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                    <Image Canvas.Right="0"
                                                        Canvas.Bottom="0"
                                                        Width="16"
                                                        Height="16">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                                <Binding Source="Shell32.dll" />
                                                                <Binding Source="168" />
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </Canvas>
                                                <Extensions:ContentToggleButton.OverContent>
                                                    <ListBox Height="200"
                                                        VerticalContentAlignment="Center"
                                                        ItemsSource="{Binding AudioFiles, Mode=OneWay}"
                                                        SelectedItem="{Binding AudioFilePath, Mode=TwoWay, Source={x:Static twainproperties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock VerticalAlignment="Center">
                                                                    <Run Text="{Binding Mode=OneWay, Converter={StaticResource FileNameExtractConverter}}" />
                                                                    <Hyperlink BaselineAlignment="Center"
                                                                        Command="{Binding DataContext.PlayAudio, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding Mode=OneWay}"
                                                                        TextDecorations="None">
                                                                        <Image Width="16" Height="16">
                                                                            <Image.Source>
                                                                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                                                    <Binding Source="Shell32.dll" />
                                                                                    <Binding Source="137" />
                                                                                </MultiBinding>
                                                                            </Image.Source>
                                                                        </Image>
                                                                    </Hyperlink>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Extensions:ContentToggleButton.OverContent>
                                            </Extensions:ContentToggleButton>
                                        </CheckBox>
                                        <CheckBox VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            twainctrl:Policy.PolicyName="NotifyCalendar"
                                            IsChecked="{Binding NotifyCalendar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}">
                                            <Canvas Width="52"
                                                Height="32"
                                                IsEnabled="{Binding NotifyCalendar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}">
                                                <Image Width="32" Height="32">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                            <Binding Source="TimeDate.cpl" />
                                                            <Binding Source="0" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <Extensions:NumericUpDown Canvas.Bottom="6"
                                                    FontWeight="Bold"
                                                    Interval="1"
                                                    Maximum="30"
                                                    Minimum="1"
                                                    Value="{Binding NotifyCalendarDateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
                                            </Canvas>
                                        </CheckBox>
                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                        <Extensions:NumericUpDown FontWeight="Bold"
                                            Interval="1"
                                            IsEnabled="{Binding ShowMagnifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}"
                                            Maximum="10"
                                            Minimum="1"
                                            Value="{Binding MagnifyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
                                        <ToggleButton twainctrl:Policy.PolicyName="ShowMagnifier"
                                            IsChecked="{Binding ShowMagnifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}"
                                            IsEnabled="{Binding FastSimplePdfThumbViewer, Mode=OneWay, Source={x:Static properties:Settings.Default}, Converter={StaticResource ReverseBooleanConverter}}">
                                            <Canvas Width="32" Height="32">
                                                <Image Width="32" Height="32">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                            <Binding Source="Shell32.dll" />
                                                            <Binding Source="1" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <Image Width="32" Height="32">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                            <Binding Source="Shell32.dll" />
                                                            <Binding Source="22" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Canvas>
                                        </ToggleButton>
                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                        <ToggleButton IsChecked="{Binding Path=SearchInArchiveFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}">
                                            <Canvas Width="32" Height="32">
                                                <Image Width="32" Height="32">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                            <Binding Source="Shell32.dll" />
                                                            <Binding Source="55" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <Image Width="16" Height="16">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                            <Binding Source="ZipFldr.dll" />
                                                            <Binding Source="0" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Canvas>
                                        </ToggleButton>
                                        <Extensions:ContentToggleButton IsEnabled="{Binding Path=SearchInArchiveFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}">
                                            <Extensions:ContentToggleButton.OverContent>
                                                <Extensions:CheckComboBox Items="{Binding SearchArchiveTypes}" Watermark="{twainctrl:Loc FILE}" />
                                            </Extensions:ContentToggleButton.OverContent>
                                        </Extensions:ContentToggleButton>
                                        <Extensions:NumericUpDown FontWeight="Bold"
                                            Interval="1"
                                            IsEnabled="{Binding Path=SearchInArchiveFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}"
                                            Maximum="1024"
                                            Minimum="0"
                                            StringFormat="{}{0} MB"
                                            Value="{Binding SearchInArchiveFileLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Separator Margin="0,1,0,1" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                    Template="{StaticResource HorizontalScrollViewerTemplate}"
                                    VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal">
