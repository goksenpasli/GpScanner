                                    <Binding Source="201" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <TextBlock VerticalAlignment="Center" Text="ESCL" />
                    </StackPanel>
                </TabItem.Header>
                <AdornerDecorator>
                    <UniformGrid Columns="3">
