<Window x:Class="GpScanner.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:GpScanner.ViewModel"
    Title="GPSCANNER"
    Width="480"
    Height="480"
    d:DataContext="{d:DesignInstance Type=viewmodel:SplashViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <viewmodel:RippleEffect x:Key="FlagRippleEffect" Progress="{Binding FlagProgress}" />
    </Window.Resources>
    <Grid>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Storyboard.TargetName="EllipseBrush"
                            Storyboard.TargetProperty="Color"
                            From="Red"
                            To="Green"
                            Duration="0:0:1.5" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Image Source="/splash.png">
            <Image.Effect>
                <DropShadowEffect BlurRadius="20"
                    Opacity="0.25"
                    RenderingBias="Quality"
                    ShadowDepth="5" />
            </Image.Effect>
        </Image>
        <TextBlock Margin="0,0,0,120"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            d:Text="BİR TARAYICIDAN FAZLASI"
            FontSize="14"
            Foreground="White"
            Text="{Binding SplashText}" />
        <Ellipse Width="13"
            Height="13"
            Margin="388,344,79,123">
            <Ellipse.Fill>
                <SolidColorBrush x:Name="EllipseBrush" Color="Red" />
            </Ellipse.Fill>
        </Ellipse>
        <Path Width="365"
            Height="130"
            Margin="0,18,7,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stretch="Fill">
            <Path.Fill>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Image d:Source="/Resources/flag-of-Turkey.png"
                            Effect="{StaticResource FlagRippleEffect}"
                            Opacity="0.15"
                            Source="{Binding FlagUri}"
                            Stretch="Fill" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Path.Fill>
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,0">
                        <LineSegment Point="283,0" />
                        <LineSegment Point="300,200" />
                        <LineSegment Point="0,200" />
                        <LineSegment Point="20,0" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Grid>
</Window>
