                            <Run Text="{Binding Mode=OneWay, ElementName=LbDoc, Path=Items.Count}" />
                            <Run Text="{twainctrl:Loc DOCUMENT}" />
                            <Run Text="{Binding TotalFileSize, Mode=OneWay, StringFormat={}{0} MB}" />
                        </TextBlock>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                        <Image Width="16"
                            Height="16"
                            Visibility="{Binding PdfBatchRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                    <Binding Source="Shell32.dll" />
                                    <Binding Source="20" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Extensions:ContentToggleButton Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            IsChecked="{Binding CalendarPanelIsExpanded, Mode=OneWay}">
                            <Extensions:ContentToggleButton.OverContent>
                                <Extensions:ResizablePanel Width="420"
                                    Height="480"
                                    MinWidth="420"
                                    MinHeight="480">
                                    <Extensions:ResizablePanel.Resources>
                                        <PdfViewer:PdfPageToThumbImageConverter x:Key="PdfPageToThumbImageConverter" Dpi="48" />
                                    </Extensions:ResizablePanel.Resources>
                                    <local:ReminderView />
                                </Extensions:ResizablePanel>
                            </Extensions:ContentToggleButton.OverContent>
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="TimeDate.cpl" />
                                        <Binding Source="0" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Extensions:ContentToggleButton>
                        <Extensions:ContentToggleButton Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Command="{Binding LoadContributionData}">
                            <Extensions:ContentToggleButton.OverContent>
                                <Extensions:ResizablePanel Width="700"
                                    Height="185"
                                    MinWidth="700"
                                    MinHeight="185">
                                    <local:YearContributionView />
                                </Extensions:ResizablePanel>
                            </Extensions:ContentToggleButton.OverContent>
                            <TextBlock FontFamily="Webdings"
                                FontSize="16"
                                Foreground="GreenYellow"
                                Text="" />
                        </Extensions:ContentToggleButton>
                        <Extensions:ContentToggleButton Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            ContentHorizontalOffset="-75"
                            ContentVerticalOffset="-10"
                            IsChecked="{Binding DocumentPanelIsExpanded, Mode=OneWay}"
                            IsEnabled="{Binding DocumentPanelIsExpanded, Mode=OneWay}"
                            PlacementMode="Top"
                            StaysOpen="{Binding DocumentPanelIsExpanded, Mode=OneWay}"
                            TopMost="False">
                            <Extensions:ContentToggleButton.OverContent>
                                <Extensions:ResizablePanel Width="260"
                                    Height="150"
                                    MinWidth="260"
                                    MinHeight="150">
                                    <local:MiniDocumentView />
                                </Extensions:ResizablePanel>
                            </Extensions:ContentToggleButton.OverContent>
                            <Image Width="16"
                                Height="16"
                                VerticalAlignment="Bottom">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="Shell32.dll" />
                                        <Binding Source="19" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Extensions:ContentToggleButton>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                        <Extensions:ContentToggleButton AllowDrop="True"
                            Background="Transparent"
                            BorderThickness="2"
                            Drop="QrListBox_Drop"
                            IsEnabled="{Binding DetectBarCode}"
                            Style="{StaticResource ContentToggleButtonAnimationStyle}">
                            <Extensions:ContentToggleButton.OverContent>
                                <local:QrDialogView />
                            </Extensions:ContentToggleButton.OverContent>
                            <TextBlock>
                                <Run Text="{Binding BarcodeList.Count, Mode=OneWay}" />
                                <Run Text="{twainctrl:Loc QRDETECT}" />
                            </TextBlock>
                        </Extensions:ContentToggleButton>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                        <Extensions:ContentToggleButton HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Content="{twainctrl:Loc BATCH}"
                            IsChecked="{Binding BatchDialogOpen}"
                            StaysOpen="True"
                            TopMost="False">
                            <Extensions:ContentToggleButton.Style>
                                <Style TargetType="Extensions:ContentToggleButton">
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RegisterBatchWatcher, Mode=OneWay, Source={x:Static properties:Settings.Default}}" Value="true">
                                            <Setter Property="Foreground" Value="GreenYellow" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Extensions:ContentToggleButton.Style>
                            <Extensions:ContentToggleButton.OverContent>
                                <local:BatchDialogView />
                            </Extensions:ContentToggleButton.OverContent>
                        </Extensions:ContentToggleButton>
                        <Extensions:ContentToggleButton HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Command="{Binding LoadUnindexedFiles}">
                            <Grid>
                                <ProgressBar Background="{x:Null}"
                                    BorderBrush="{x:Null}"
                                    IsIndeterminate="{Binding OcrIsBusy}"
                                    Maximum="1"
                                    Value="{Binding OcrAllPdfPagesProgress}" />
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="16" Height="16">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                <Binding Source="Shell32.dll" />
                                                <Binding Source="171" />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="{twainctrl:Loc UNINDEXED}" />
                                </StackPanel>
                            </Grid>
                            <Extensions:ContentToggleButton.OverContent>
                                <Extensions:ResizablePanel Width="800"
                                    Height="400"
                                    MinWidth="800"
                                    MinHeight="400">
                                    <local:UnindexedFilesDialogView />
                                </Extensions:ResizablePanel>
                            </Extensions:ContentToggleButton.OverContent>
                        </Extensions:ContentToggleButton>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>