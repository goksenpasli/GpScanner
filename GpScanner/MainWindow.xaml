<Window x:Class="GpScanner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converter="clr-namespace:GpScanner.Converter"
    xmlns:Extensions="clr-namespace:Extensions;assembly=Extensions"
    xmlns:PdfViewer="clr-namespace:PdfViewer;assembly=PdfViewer"
    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:ViewModel="clr-namespace:GpScanner.ViewModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GpScanner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:GpScanner.Properties"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tesseract="clr-namespace:Ocr;assembly=Ocr"
    xmlns:twainctrl="clr-namespace:TwainControl;assembly=TwainControl"
    xmlns:twainproperties="clr-namespace:TwainControl.Properties;assembly=TwainControl"
    x:Name="Window"
    Title="GPSCANNER"
    d:DataContext="{d:DesignInstance Type={x:Type ViewModel:GpScannerViewModel}}"
    d:Height="600"
    d:Width="1280"
    twainctrl:Translation.ResourceManager="{x:Static twainproperties:Resources.ResourceManager}"
    Closing="Window_Closing"
    ContentRendered="MW_ContentRendered"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="F"
            Command="{Binding FocusControl}"
            CommandParameter="{Binding ElementName=TbSearch}"
            Modifiers="Ctrl" />
        <KeyBinding Key="F1" Command="{Binding OpenHelpDialog, ElementName=twainCtrl}" />
        <KeyBinding Key="S"
            Command="{Binding ScanImage, ElementName=twainCtrl}"
            Modifiers="Alt" />
        <KeyBinding Key="F"
            Command="{Binding FastScanImage, ElementName=twainCtrl}"
            Modifiers="Alt" />
        <KeyBinding Key="S"
            Command="{Binding SeçiliDirektPdfKaydet, ElementName=twainCtrl}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding Key="S"
            Command="{Binding SaveSelectedFilesPdfFile, ElementName=twainCtrl}"
            Modifiers="Ctrl" />
        <KeyBinding Key="O"
            Command="{Binding LoadImage, ElementName=twainCtrl}"
            Modifiers="Ctrl" />
        <KeyBinding Key="A"
            Command="{Binding Tümünüİşaretle, ElementName=twainCtrl}"
            Modifiers="Ctrl" />
        <KeyBinding Key="D"
            Command="{Binding TümününİşaretiniKaldır, ElementName=twainCtrl}"
            Modifiers="Ctrl" />
        <KeyBinding Key="D"
            Command="{Binding DuplicateSelectedImage, ElementName=twainCtrl}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding Key="Delete" Command="{Binding SeçiliListeTemizle, ElementName=twainCtrl}" />
        <KeyBinding Key="Delete"
            Command="{Binding ListeTemizle, ElementName=twainCtrl}"
            Modifiers="Shift" />
        <KeyBinding Key="V"
            Command="{Binding InsertClipBoardImage, ElementName=twainCtrl}"
            Modifiers="Ctrl" />
        <KeyBinding Key="P"
            Command="{Binding PrintSelectedDocuments, ElementName=twainCtrl}"
            Modifiers="Ctrl" />
        <KeyBinding Key="Z"
            Command="{Binding ResimSilGeriAl, ElementName=twainCtrl}"
            Modifiers="Ctrl" />
        <KeyBinding Key="Tab"
            Command="{Binding MoveToNextTabCommand, ElementName=twainCtrl}"
            Modifiers="Control" />
        <KeyBinding Key="Tab"
            Command="{Binding MoveToPreviousTabCommand, ElementName=twainCtrl}"
            Modifiers="Control+Shift" />
    </Window.InputBindings>
    <Window.Resources>
        <ViewModel:FoldEffect x:Key="Fold"
            PresentationOptions:Freeze="true"
            FoldAmount="{Binding Fold}" />
        <ViewModel:RippleEffect x:Key="Ripple"
            PresentationOptions:Freeze="true"
            Progress="{Binding Ripple}" />
        <ViewModel:MirrorAngleEffect x:Key="Mirror"
            PresentationOptions:Freeze="true"
            RelativeHeight="{Binding Mirror}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Converter:SelectedSizeToCacheLengthConverter x:Key="SelectedSizeToCacheLengthConverter" />
        <Extensions:ReverseBooleanConverter x:Key="ReverseBooleanConverter" />
        <Converter:CustomSizeToSizeConverter x:Key="CustomSizeToSizeConverter" />
        <Converter:NumberRangeToColorConverter x:Key="ComboBoxNumberRangeToColorConverter"
            MaxNumber="100"
            MinNumber="5" />
        <Converter:NumberRangeToColorConverter x:Key="UpdateNumberRangeToColorConverter"
            MaxNumber="120"
            MinNumber="1" />
        <Converter:NumberRangeToColorConverter x:Key="ComboBoxPdfNumberRangeToColorConverter"
            MaxNumber="1200"
            MinNumber="12" />
        <CollectionViewSource x:Key="Veriler" Source="{Binding Dosyalar}" />
        <Style x:Key="ListBoxAnimationStyle" TargetType="{x:Type ListBox}">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ListBoxBorderAnimation}" Value="true">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Sb">
                            <Storyboard RepeatBehavior="Forever">
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                    To="Red"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding ListBoxBorderAnimation}" Value="false">
                    <DataTrigger.EnterActions>
                        <StopStoryboard BeginStoryboardName="Sb" />
                        <RemoveStoryboard BeginStoryboardName="Sb" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BorderAnimationStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Seçili}" Value="true">
                    <Setter Property="BorderBrush" Value="MediumSeaGreen" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BorderAnimation}" Value="true">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Sb">
                            <Storyboard Timeline.DesiredFrameRate="12">
                                <DoubleAnimationUsingKeyFrames RepeatBehavior="1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                                    <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="5" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="-5" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding BorderAnimation}" Value="false">
                    <DataTrigger.EnterActions>
                        <StopStoryboard BeginStoryboardName="Sb" />
                        <RemoveStoryboard BeginStoryboardName="Sb" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContentToggleButtonAnimationStyle" TargetType="{x:Type Extensions:ContentToggleButton}">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="GreenYellow" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BarcodeList.Count}" Value="0">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ListBoxBorderAnimation}" Value="true">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Sb">
                            <Storyboard RepeatBehavior="Forever">
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                    To="Red"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding ListBoxBorderAnimation}" Value="false">
                    <DataTrigger.EnterActions>
                        <StopStoryboard BeginStoryboardName="Sb" />
                        <RemoveStoryboard BeginStoryboardName="Sb" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource BorderBackground}" />
        </Style>
        <Style TargetType="{x:Type RepeatButton}">
            <Setter Property="Background" Value="{StaticResource BorderBackground}" />
        </Style>
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{StaticResource BorderBackground}" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Template" Value="{StaticResource ComboBoxStyle}" />
        </Style>
        <Style TargetType="{x:Type Extensions:ContentToggleButton}">
            <Setter Property="Background" Value="{StaticResource BorderBackground}" />
        </Style>
        <Style TargetType="{x:Type Extensions:SplitButton}">
            <Setter Property="Background" Value="{StaticResource BorderBackground}" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownStyle}" TargetType="Extensions:NumericUpDown" />
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Scanner.ProgressState, ElementName=twainCtrl}" ProgressValue="{Binding Scanner.PdfSaveProgressValue, ElementName=twainCtrl, Mode=OneWay}">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo Command="{Binding FastScanImage, Mode=OneWay, ElementName=twainCtrl}" Description="{twainctrl:Loc FASTSCAN}">
                    <ThumbButtonInfo.ImageSource>
                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                            <Binding Source="Shell32.dll" />
                            <Binding Source="201" />
                        </MultiBinding>
                    </ThumbButtonInfo.ImageSource>
                </ThumbButtonInfo>
                <ThumbButtonInfo Command="{Binding LoadImage, Mode=OneWay, ElementName=twainCtrl}" Description="{twainctrl:Loc FILE}">
                    <ThumbButtonInfo.ImageSource>
                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                            <Binding Source="Shell32.dll" />
                            <Binding Source="139" />
                        </MultiBinding>
                    </ThumbButtonInfo.ImageSource>
                </ThumbButtonInfo>
                <ThumbButtonInfo Command="{Binding InsertClipBoardImage, Mode=OneWay, ElementName=twainCtrl}" Description="{twainctrl:Loc PASTE}">
                    <ThumbButtonInfo.ImageSource>
                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                            <Binding Source="Shell32.dll" />
                            <Binding Source="260" />
                        </MultiBinding>
                    </ThumbButtonInfo.ImageSource>
                </ThumbButtonInfo>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid x:Name="grid" d:Effect="{x:Null}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=AnimationType, Source={x:Static properties:Settings.Default}}" Value="0">
                        <Setter Property="Effect" Value="{StaticResource Fold}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=AnimationType, Source={x:Static properties:Settings.Default}}" Value="1">
                        <Setter Property="Effect" Value="{StaticResource Ripple}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=AnimationType, Source={x:Static properties:Settings.Default}}" Value="2">
                        <Setter Property="Effect" Value="{StaticResource Mirror}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding MainWindowGuiControlLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" d:Width="3*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="{Binding MainWindowDocumentGuiControlLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" d:Width="2*" />
        </Grid.ColumnDefinitions>
        <twainctrl:TwainCtrl x:Name="twainCtrl" twainctrl:Policy.PolicyName="TwainCtrl" />
        <Extensions:SystemTrayIcon d:IsHidden="True"
            IconUri="scanner.ico"
            SingleClickCommand="{Binding AppBringToFront}"
            ToolTipText="GPSCANNER"
            TrayIconActive="{Binding ShowTrayIcon, Mode=OneWay, Source={x:Static properties:Settings.Default}}">
            <Extensions:SystemTrayIcon.ContextMenu>
                <ContextMenu Padding="0"
                    Background="#2C3238"
                    BorderBrush="#494E52">
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Background" Value="#2C3238" />
                            <Setter Property="BorderBrush" Value="#2C3238" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Command="{Binding CheckUpdate}" Header="{twainctrl:Loc UPDATE}">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="Shell32.dll" />
                                        <Binding Source="13" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding OpenSettings}" Header="{twainctrl:Loc SETTİNGS}">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="Shell32.dll" />
                                        <Binding Source="21" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem IsCheckable="True" IsChecked="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static properties:Settings.Default}}">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="Shell32.dll" />
                                        <Binding Source="24" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock>
                                <Run Text="{twainctrl:Loc Auto}" />
                                <Run Text="{twainctrl:Loc RUN}" />
                            </TextBlock>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding CloseApp}" Header="{twainctrl:Loc EXIT}">
                        <MenuItem.Icon>
                            <Image Width="16"
                                Height="16"
                                Source="/TwainControl;component/Icons/delete.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Margin="5,-1,0,0" />
                    <MenuItem Command="{Binding TwainCtrl.WebAdreseGit}"
                        CommandParameter="https://github.com/goksenpasli"
                        Header="{twainctrl:Loc ABOUT}">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="Shell32.dll" />
                                        <Binding Source="14" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Extensions:SystemTrayIcon.ContextMenu>
        </Extensions:SystemTrayIcon>
        <Extensions:FadedToolTipControl d:IsHidden="True"
            Background="{StaticResource Dur}"
            BorderBrush="{x:Null}"
            PopupParent="{Binding ElementName=grid}"
            Position="Center"
            Show="{Binding ShowUnindexedFileWarn}"
            TimeToClose="4000"
            TimeToShow="0">
            <Grid Width="250"
                Height="250"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Dur}">
                <TextBlock Margin="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    d:Text="WARN"
                    FontSize="25"
                    Foreground="White"
                    Text="{twainctrl:Loc WARNUNINDEXFILES}"
                    TextWrapping="Wrap" />
            </Grid>
        </Extensions:FadedToolTipControl>
        <GridSplitter Grid.Column="1"
            Width="3"
            HorizontalAlignment="Stretch"
            Background="{StaticResource GroupBoxBackGround}"
            ToolTip="{twainctrl:Loc SPLITTERTOOLTIP}">
            <GridSplitter.InputBindings>
                <MouseBinding Command="{Binding GridSplitterMouseDoubleClick}" Gesture="LeftDoubleClick" />
                <MouseBinding Command="{Binding GridSplitterMouseRightButtonDown}" Gesture="RightClick" />
            </GridSplitter.InputBindings>
        </GridSplitter>
        <GroupBox Grid.Column="2" twainctrl:Policy.PolicyName="DocumentPanel">
            <GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <UniformGrid Columns="2">
                        <Button twainctrl:Policy.PolicyName="OpenSettings" Command="{Binding OpenSettings}">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                            <Binding Source="Shell32.dll" />
                                            <Binding Source="21" />
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <TextBlock VerticalAlignment="Center" Text="{twainctrl:Loc SETTİNGS}" />
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="TbExpandDocument"
                            Command="{Binding ModifyGridWidth}"
                            IsChecked="{Binding DocumentPanelIsExpanded}">
                            <ToggleButton.Style>
                                <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="CommandParameter" Value="1" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Image Width="16"
                                                        Height="16"
                                                        RenderTransformOrigin="0.5,0.5">
                                                        <Image.RenderTransform>
                                                            <TransformGroup>
                                                                <RotateTransform Angle="180" />
                                                            </TransformGroup>
                                                        </Image.RenderTransform>
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                                <Binding Source="Shell32.dll" />
                                                                <Binding Source="252" />
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="CommandParameter" Value="0" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Image Width="16" Height="16">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                                <Binding Source="Shell32.dll" />
                                                                <Binding Source="252" />
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </UniformGrid>
                    <Extensions:ContentToggleButton Grid.Column="1"
                        HorizontalAlignment="Right"
                        ArrowVisibility="Collapsed"
                        Background="{x:Null}"
                        BorderBrush="{x:Null}">
                        <Image Width="16" Height="16">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                    <Binding Source="Comres.dll" />
                                    <Binding Source="11" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Extensions:ContentToggleButton.OverContent>
                            <GroupBox>
                                <local:MiniHelpWindow />
                            </GroupBox>
                        </Extensions:ContentToggleButton.OverContent>
                    </Extensions:ContentToggleButton>
                </Grid>
            </GroupBox.Header>
            <TabControl Background="{StaticResource BorderBackground}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                        <Binding Source="TimeDate.cpl" />
                                        <Binding Source="0" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <TextBlock VerticalAlignment="Center" Text="{twainctrl:Loc CALENDAR}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            Template="{StaticResource HorizontalScrollViewerTemplate}"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Background="{StaticResource BorderBackground}" Orientation="Horizontal">
                                <Extensions:SplitButton twainctrl:Policy.PolicyName="Tümünüİşaretle"
                                    BorderBrush="Cyan"
                                    Command="{Binding Tümünüİşaretle}">
                                    <Extensions:SplitButton.InternalContent>
                                        <StackPanel Orientation="Horizontal">
                                            <Button twainctrl:Policy.PolicyName="TümününİşaretiniKaldır"
                                                BorderBrush="Cyan"
                                                Command="{Binding TümününİşaretiniKaldır}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="32"
                                                        Height="32"
                                                        Source="/TwainControl;component/Icons/none.png" />
                                                    <TextBlock VerticalAlignment="Center" Text="{twainctrl:Loc NONE}" />
                                                </StackPanel>
                                            </Button>
                                            <Button twainctrl:Policy.PolicyName="Tersiniİşaretle"
                                                BorderBrush="Cyan"
                                                Command="{Binding Tersiniİşaretle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="32"
                                                        Height="32"
                                                        Source="/TwainControl;component/Icons/inverse.png" />
                                                    <TextBlock VerticalAlignment="Center" Text="{twainctrl:Loc REVERSE}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Extensions:SplitButton.InternalContent>
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas Width="32" Height="32">
                                            <Image Width="32"
                                                Height="32"
                                                Source="/TwainControl;component/Icons/selectall.png" />
                                            <TextBlock Canvas.Top="7"
                                                Width="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                d:Text="0"
                                                FontWeight="Bold"
                                                Foreground="Red"
                                                Text="{Binding CheckedPdfCount}"
                                                TextAlignment="Center" />
                                        </Canvas>
                                        <TextBlock VerticalAlignment="Center" Text="{twainctrl:Loc ALL}" />
                                    </StackPanel>
                                </Extensions:SplitButton>
                                <ComboBox VerticalContentAlignment="Center"
                                    d:SelectedValue="330,530"
                                    twainctrl:Policy.PolicyName="SelectedSize"
                                    SelectedValue="{Binding SelectedSize}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{twainctrl:Loc SMALLEST}">
                                        <ComboBoxItem.Tag>
                                            <Size Width="190" Height="305" />
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{twainctrl:Loc SMALL}">
                                        <ComboBoxItem.Tag>
                                            <Size Width="230" Height="370" />
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{twainctrl:Loc MIDDLE}">
                                        <ComboBoxItem.Tag>
                                            <Size Width="330" Height="530" />
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{twainctrl:Loc BIG}">
                                        <ComboBoxItem.Tag>
                                            <Size Width="380" Height="610" />
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{twainctrl:Loc BIGGEST}">
                                        <ComboBoxItem.Tag>
                                            <Size Width="425" Height="645" />
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <Separator />
                                    <ComboBoxItem>
                                        <ComboBoxItem.Tag>
                                            <MultiBinding Converter="{StaticResource CustomSizeToSizeConverter}">
                                                <Binding Path="CustomWidth" Source="{x:Static properties:Settings.Default}" />
                                                <Binding Path="CustomHeight" Source="{x:Static properties:Settings.Default}" />
                                            </MultiBinding>
                                        </ComboBoxItem.Tag>
                                        <StackPanel Orientation="Horizontal">
                                            <UniformGrid Width="65" Rows="2">
                                                <Extensions:NumericUpDown Interval="1"
                                                    Maximum="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}}"
                                                    Minimum="100"
                                                    MouseSelectAllText="True"
                                                    ToolTip="{twainctrl:Loc CWIDTH}"
                                                    Value="{Binding CustomWidth, Mode=TwoWay, Source={x:Static properties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}" />
                                                <Extensions:NumericUpDown Interval="1"
                                                    Minimum="100"
                                                    MouseSelectAllText="True"
                                                    ToolTip="{twainctrl:Loc CHEIGHT}"
                                                    Value="{Binding CustomHeight, Mode=TwoWay, Source={x:Static properties:Settings.Default}, UpdateSourceTrigger=PropertyChanged}" />
                                            </UniformGrid>
                                            <Button Background="{x:Null}"
                                                BorderBrush="{x:Null}"
                                                Command="{Binding ApplyCustomSize}">
                                                <Image Width="24" Height="24">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource SystemFileIconConverter}">
                                                            <Binding Source="Shell32.dll" />
                                                            <Binding Source="144" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Button>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="PDF" />
                                    <Run Text="{twainctrl:Loc ALL}" />
                                    <LineBreak />
                                    <Run Text="{twainctrl:Loc PAGENUMBER}" />
                                </TextBlock>
                                <UniformGrid Columns="2">
                                    <UniformGrid IsEnabled="{Binding FastSimplePdfThumbViewer, Mode=OneWay, Source={x:Static properties:Settings.Default}, Converter={StaticResource ReverseBooleanConverter}}" Rows="2">
                                        <Extensions:NumericUpDown twainctrl:Policy.PolicyName="AllPdfPage"
                                            Interval="1"
                                            Minimum="1"
                                            Value="{Binding AllPdfPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
